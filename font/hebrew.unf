anchor -he-dagesh 0..1 0
glyph @:2x2 2 2 mark advance 0 origin -3 -7
/11\
\11/
anchor -he-dagesh 0..1 0..1

glyph he-shin-dot 1 2 mark advance 0 origin -7 0 // ׁ
d3
3P
anchor -he-shin-dot 0 0..1

glyph he-sin-dot 1 2 mark advance 0 origin -1 0 // ׂ
d3
3P
anchor -he-sin-dot 0 0..1

map U+05B9 = he-holam
map U+05BA = he-holam-vav
map U+05BC = he-dagesh
map U+05BF = he-rafe
map U+05C1 = he-shin-dot
map U+05C2 = he-sin-dot
map U+FB1E = he-rafe // judeo-spanish varika, effectively same as rafe

feature ccmp for hebr : anchor he-dagesh
feature ccmp for hebr : anchor he-shin-dot
feature ccmp for hebr : anchor he-sin-dot
feature ccmp for hebr : anchor he-holam-vav
feature ccmp for hebr : he-with-dagesh
feature ccmp for hebr : he-dot-dagesh
feature ccmp for hebr : he-dot-dagesh-drop

remap group he-dot-dagesh after he-with-dagesh
remap group he-dot-dagesh-drop after he-dot-dagesh

name-parts $he-with-dagesh = alef alef-wide dalet dalet-wide vav zayin nun-final shin

remap he-with-dagesh : he-($he-with-dagesh) he-dagesh -> he-($he-with-dagesh)-with-dagesh
// combined: he-shin he-shin/sin-dot he-dagesh -> he-shin-with-dagesh he-shin/sin-dot
remap he-dot-dagesh : he-shin -> he-shin-with-dagesh : he-(shin|sin)-dot he-dagesh
remap he-dot-dagesh-drop : he-shin-with-dagesh he-(shin|sin)-dot : he-dagesh -> 

// he-shin/sin-dot are placed at the exact position regardless of he-shin
assert shape שׁ @hebr : he-shin-dot advance 0 offset 0 0 : he-shin
assert shape שׂ @hebr : he-sin-dot advance 0 offset 0 0 : he-shin
assert shape םׁ @hebr : he-shin-dot advance 0 offset 0 0 : he-mem-final
assert shape םׂ @hebr : he-sin-dot advance 0 offset 0 0 : he-mem-final

