## tests

// a below point picks the base alternative whose `+he-below` slot holds it:
// the base as drawn where it fits, `:w3-below`/`:w7-below` otherwise.
assert shape דְ @hebr : he-sheva advance 0 offset -1 0 : he-dalet // dalet own slot is 3x1, sheva asks for 3x1
assert shape דֲ @hebr : he-hataf-patah advance 0 offset -1 0 : he-dalet:w7-below // 5x1 does not fit, so the wide alternative
assert shape רְ @hebr : he-sheva advance 0 offset -1 0 : he-resh // resh own slot is 5x1
assert shape רֲ @hebr : he-hataf-patah advance 0 offset -1 0 : he-resh // and 5x1 still fits it
assert shape הְ @hebr : he-sheva advance 0 offset -1 0 : he-he
assert shape הֲ @hebr : he-hataf-patah advance 0 offset -1 0 : he-he:w7-below
assert shape קְ @hebr : he-sheva advance 0 offset 0 0 : he-qof:w3-below // qof draws no slot itself: first fit among its alternatives
assert shape קֲ @hebr : he-hataf-patah advance 0 offset 0 0 : he-qof:w7-below
assert shape ןְ @hebr : he-sheva advance 0 offset -1 0 : he-nun-final:w3-below
assert shape ןֻ @hebr : he-qubuts advance 0 offset -1 0 : he-nun-final:w7-below
assert shape ץַ @hebr : he-patah advance 0 offset 1 0 : he-tsadi-final:w3-below
assert shape ץֻ @hebr : he-qubuts advance 0 offset 0 0 : he-tsadi-final:w7-below
assert shape בְ @hebr : he-sheva advance 0 offset -1 0 : he-bet:w7-below // bet has one alternative only, so every point takes it
assert shape טְ @hebr : he-sheva advance 0 offset -1 0 : he-tet:w7-below
assert shape נְ @hebr : he-sheva advance 0 offset -1 0 : he-nun:h7-below // the one alternative named for the height it gains
assert shape יְ @hebr : he-sheva advance 0 offset -1 0 : he-yod // yod and yod-triangle draw a 7x1 slot: nothing to substitute
assert shape יֻ @hebr : he-qubuts advance 0 offset -1 0 : he-yod
assert shape וְ @hebr : he-sheva advance 0 offset -1 0 : he-vav
assert shape ﬠ @hebr : he-ayin:w7-below // the alternative is a character of its own as well
assert shape ﬠְ @hebr : he-sheva advance 0 offset 0 0 : he-ayin:w7-below

// `he-meteg` ligates the point before the slot is fitted, so the base
// follows the *ligature* footprint and not the point it was written with.
assert shape דִֽ @hebr : he-meteg-hiriq advance 0 offset -1 0 : he-dalet // meteg-hiriq is still 3x1
assert shape דָֽ @hebr : he-meteg-qamats advance 0 offset -1 0 : he-dalet:w7-below // meteg-qamats is 5x1: dalet has to give way
assert shape רָֽ @hebr : he-meteg-qamats advance 0 offset -1 0 : he-resh // resh does not, its own slot is 5x1
assert shape רֲֽ @hebr : he-meteg-hataf-patah advance 0 offset -1 0 : he-resh:w7-below // but meteg-hataf-patah is 7x1
assert shape קֻֽ @hebr : he-meteg-qubuts advance 0 offset 0 0 : he-qof:w7-below
assert shape בֽ @hebr : he-meteg advance 0 offset -1 0 : he-bet:w7-below // meteg alone is an ordinary below point
assert shape דָֽ @hebr : he-meteg-qamats advance 0 offset -1 0 : he-dalet:w7-below // the same written meteg first: the shaper orders it back
assert shape דֹֽ @hebr : he-meteg advance 0 offset -1 0 : he-holam advance 0 offset -1 0 : he-dalet // holam is not a below point: no ligature

// the reverse direction: a base slot picks the *mark* alternative.
// dagesh is 1x1 and grows to fill what the letter offers.
assert shape ץּ @hebr : he-dagesh advance 0 offset -3 1 : he-tsadi-final
assert shape תּ @hebr : he-dagesh advance 0 offset 0 -1 : he-tav
assert shape םּ @hebr : he-dagesh:1x2 advance 0 offset 0 0 : he-mem-final
assert shape כּ @hebr : he-dagesh:1x2 advance 0 offset -1 0 : he-kaf
assert shape לּ @hebr : he-dagesh advance 0 offset -1 -1 : he-lamed
assert shape חּ @hebr : he-dagesh:2x2 advance 0 offset 0 1 : he-het
assert shape עּ @hebr : he-dagesh:2x2 advance 0 offset 1 -1 : he-ayin

// both directions at once: the below point moves the base to an
// alternative, whose own `+he-dagesh` slot then re-picks the dagesh.
assert shape חְּ @hebr : he-sheva advance 0 offset -1 0 : he-dagesh:2x2 advance 0 offset 0 1 : he-het // het keeps its base, and so its 2x2 dagesh
assert shape עְּ @hebr : he-sheva advance 0 offset 0 0 : he-dagesh:2x1 advance 0 offset 1 -2 : he-ayin:w7-below // ayin gives way, and the wide form offers 2x1
assert shape םְּ @hebr : he-sheva advance 0 offset 0 0 : he-dagesh advance 0 offset 0 -1 : he-mem-final:w7-below
assert shape בְּֿ @hebr : he-sheva advance 0 offset -1 0 : he-rafe:w04 advance 0 offset -1 0 : he-dagesh:2x1 advance 0 offset -1 -1 : he-bet:w7-below // below, inside and above at once

// `he-with-dagesh` replaces the pair outright, for the letters whose
// dagesh no anchor can place. every other letter keeps the two glyphs.
assert shape אּ @hebr : he-alef-with-dagesh
assert shape דּ @hebr : he-dalet-with-dagesh
assert shape וּ @hebr : he-vav-with-dagesh
assert shape זּ @hebr : he-zayin-with-dagesh
assert shape ןּ @hebr : he-nun-final-with-dagesh // no precomposed character exists for this one
assert shape שּ @hebr : he-shin-with-dagesh // with no dot the pair is still adjacent
assert shape בּ @hebr : he-dagesh:2x2 advance 0 offset -1 0 : he-bet // bet is not one of them
assert shape בּ @hebr : uniFB31 // and its precomposed character is a glyph of its own

// a shin dot outranks the dagesh: the shaper hands both over dot first, so
// `he-with-dagesh` no longer sees an adjacent pair. `he-dot-dagesh` replaces
// the letter under the dot instead and `he-dot-dagesh-drop` takes the dagesh
// away afterwards, which is what the two `remap group ... after` lines buy.
assert shape שּׁ @hebr : he-shin-dot advance 0 offset 0 0 : he-shin-with-dagesh // written dagesh first
assert shape שּׁ @hebr : he-shin-dot advance 0 offset 0 0 : he-shin-with-dagesh // and written shin-dot first: the same
assert shape שּׂ @hebr : he-sin-dot advance 0 offset 0 0 : he-shin-with-dagesh // likewise for the sin dot
assert shape שּׂ @hebr : he-sin-dot advance 0 offset 0 0 : he-shin-with-dagesh
assert shape שּׁ @hebr : he-shin-with-dagesh-shin-dot // the precomposed characters draw one glyph instead
assert shape שּׂ @hebr : he-shin-with-dagesh-sin-dot

// rafe asks for a 3x1 site and grows to what the letter offers;
// where nothing fits it attaches as drawn.
assert shape וֿ @hebr : he-rafe advance 0 offset 1 0 : he-vav
assert shape בֿ @hebr : he-rafe:w04 advance 0 offset -1 0 : he-bet
assert shape נֿ @hebr : he-rafe:w05 advance 0 offset -1 0 : he-nun
assert shape אֿ @hebr : he-rafe:w06 advance 0 offset -1 0 : he-alef
assert shape לֿ @hebr : he-rafe advance 0 offset 2 0 : he-lamed // lamed offers 2x1 only: no alternative is narrower
assert shape ׯֿ @hebr : he-rafe advance 0 offset -2 0 : he-yod-triangle // nor does yod-triangle, which offers 1x1

// holam is 1x1 and fits every `+he-above` site as drawn.
assert shape אֹ @hebr : he-holam advance 0 offset -1 0 : he-alef
assert shape לֹ @hebr : he-holam advance 0 offset 2 0 : he-lamed
assert shape ׯֹ @hebr : he-holam advance 0 offset -2 0 : he-yod-triangle
assert shape שֹׂ @hebr : he-holam advance 0 offset -1 0 : he-sin-dot advance 0 offset 0 0 : he-shin // sin-dot and holam do land on each other

// holam-vav is a class of its own, which vav alone offers.
assert shape וֺ @hebr : he-holam-vav advance 0 offset -1 0 : he-vav
assert shape וֹ @hebr : he-holam advance 0 offset 1 0 : he-vav // not the same site as holam
assert shape בֺ @hebr : he-holam-vav advance 0 offset 0 0 : he-bet // nothing to attach to, so it is left at the origin

// above and below at once, each fitted on its own.
assert shape דָֹֽ @hebr : he-meteg-qamats advance 0 offset -1 0 : he-holam advance 0 offset -1 0 : he-dalet:w7-below
assert shape שָׁ @hebr : he-qamats advance 0 offset -1 0 : he-shin-dot advance 0 offset 0 0 : he-shin:w7-below
assert shape אׇ @hebr : he-qamats-qatan advance 0 offset -1 0 : he-alef:w7-below

