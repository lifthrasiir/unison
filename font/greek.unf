map Α = gr-alpha-upper
map Β = gr-beta-upper
map Γ = gr-gamma-upper
map Δ = gr-delta-upper
map Ε = gr-epsilon-upper
map Ζ = gr-zeta-upper
map Η = gr-eta-upper
map Θ = gr-theta-upper
map Ι = gr-iota-upper
map Κ = gr-kappa-upper
map Λ = gr-lambda-upper
map Μ = gr-mu-upper
map Ν = gr-nu-upper
map Ξ = gr-xi-upper
map Ο = gr-omicron-upper
map Π = gr-pi-upper
map Ρ = gr-rho-upper
map Σ = gr-sigma-upper
map Τ = gr-tau-upper
map Υ = gr-upsilon-upper
map Φ = gr-phi-upper
map Χ = gr-chi-upper
map Ψ = gr-psi-upper
map Ω = gr-omega-upper

map α = gr-alpha-lower
map β = gr-beta-lower
map γ = gr-gamma-lower
map δ = gr-delta-lower
map ε = gr-epsilon-lower
map ζ = gr-zeta-lower
map η = gr-eta-lower
map θ = gr-theta-lower
map ι = gr-iota-lower
map κ = gr-kappa-lower
map λ = gr-lambda-lower
map μ = gr-mu-lower
map ν = gr-nu-lower
map ξ = gr-xi-lower
map ο = gr-omicron-lower
map π = gr-pi-lower
map ρ = gr-rho-lower
map σ = gr-sigma-lower
map ς = gr-sigma-final-lower
map τ = gr-tau-lower
map υ = gr-upsilon-lower
map φ = gr-phi-lower
map χ = gr-chi-lower
map ψ = gr-psi-lower
map ω = gr-omega-lower

## combining characters

feature ccmp for grek : anchor gr-above
feature ccmp for grek : anchor gr-below

name-parts $gr-comb = tonos varia dialytika psili dasia perispomeni
name-parts $gr-vowel = alpha epsilon eta iota omicron upsilon omega

remap gr-comb : gr-($gr-lex)-upper : acute-above -> gr-tonos
remap gr-comb : gr-($gr-lex)-lower : acute-above -> gr-tonos
remap gr-comb : gr-($gr-comb) : acute-above -> gr-tonos

remap gr-comb : gr-($gr-lex)-upper : grave-above -> gr-varia
remap gr-comb : gr-($gr-lex)-lower : grave-above -> gr-varia
remap gr-comb : gr-($gr-comb) : grave-above -> gr-varia

remap gr-comb : gr-($gr-lex)-upper : dia-above -> gr-dialytika
remap gr-comb : gr-($gr-lex)-lower : dia-above -> gr-dialytika
remap gr-comb : gr-($gr-comb) : dia-above -> gr-dialytika

remap gr-comb : gr-($gr-lex)-upper : com-above -> gr-psili
remap gr-comb : gr-($gr-lex)-lower : com-above -> gr-psili
remap gr-comb : gr-($gr-comb) : com-above -> gr-psili

remap gr-comb : gr-($gr-lex)-upper : com-reversed-above -> gr-dasia
remap gr-comb : gr-($gr-lex)-lower : com-reversed-above -> gr-dasia
remap gr-comb : gr-($gr-comb) : com-reversed-above -> gr-dasia

remap gr-merge : gr-dialytika(|:wide) gr-tonos -> gr-dialytika-tonos
remap gr-merge : gr-dialytika(|:wide) gr-varia -> gr-dialytika-varia
remap gr-merge : gr-dialytika(|:wide) gr-perispomeni -> gr-dialytika-perispomeni

remap gr-merge : gr-psili(|:wide) gr-tonos -> gr-psili-tonos
remap gr-merge : gr-psili(|:wide) gr-varia -> gr-psili-varia
remap gr-merge : gr-psili(|:wide) gr-perispomeni -> gr-psili-perispomeni

remap gr-merge : gr-dasia(|:wide) gr-tonos -> gr-dasia-tonos
remap gr-merge : gr-dasia(|:wide) gr-varia -> gr-dasia-varia
remap gr-merge : gr-dasia(|:wide) gr-perispomeni -> gr-dasia-perispomeni

remap group gr-merge after gr-comb
feature ccmp for grek : gr-comb
feature ccmp for grek : gr-merge

## with tonos/oxia (not distinguished)

glyph gr-tonos0 3 3
../VV'
.vV/..
/Vv'..

glyph gr-tonos mark advance 0
ref gr-tonos0
anchor -gr-above 1 1
anchor +gr-above 1 -1

glyph gr-tonos:wide mark advance 0
ref gr-tonos0
anchor -gr-above 0..1 1
anchor +gr-above 1 -1

glyph gr-($gr-vowel)-upper-with-tonos
ref gr-($gr-vowel)-upper
ref gr-tonos
glyph gr-($gr-vowel)-lower-with-tonos
ref gr-($gr-vowel)-lower
ref gr-tonos

map Ά|Ά = gr-alpha-upper-with-tonos
map Έ|Έ = gr-epsilon-upper-with-tonos
map Ή|Ή = gr-eta-upper-with-tonos
map Ί|Ί = gr-iota-upper-with-tonos
