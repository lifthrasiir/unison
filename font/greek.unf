map Ἑ = gr-epsilon-upper-with-dasia
map Ἡ = gr-eta-upper-with-dasia
map Ἱ = gr-iota-upper-with-dasia
map Ὁ = gr-omicron-upper-with-dasia
map Ὑ = gr-upsilon-upper-with-dasia
map Ὡ = gr-omega-upper-with-dasia
map Ῥ = gr-rho-upper-with-dasia

map ἁ = gr-alpha-lower-with-dasia
map ἑ = gr-epsilon-lower-with-dasia
map ἡ = gr-eta-lower-with-dasia
