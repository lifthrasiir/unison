// with dasia

glyph gr-dasia mark
ref com-reversed-above:narrow inherit
anchor -gr-above 1 1
anchor +gr-above 1 -1

glyph gr-dasia:wide mark
ref com-reversed-above inherit
anchor -gr-above 0..1 1
anchor +gr-above 0..1 -1

