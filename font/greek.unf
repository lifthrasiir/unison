map Α = gr-alpha-upper
map Β = gr-beta-upper
map Γ = gr-gamma-upper
map Δ = gr-delta-upper
map Ε = gr-epsilon-upper
map Ζ = gr-zeta-upper
map Η = gr-eta-upper
map Θ = gr-theta-upper
map Ι = gr-iota-upper
map Κ = gr-kappa-upper
map Λ = gr-lambda-upper
map Μ = gr-mu-upper
map Ν = gr-nu-upper
map Ξ = gr-xi-upper
map Ο = gr-omicron-upper
map Π = gr-pi-upper
map Ρ = gr-rho-upper
map Σ = gr-sigma-upper
map Τ = gr-tau-upper
map Υ = gr-upsilon-upper
map Φ = gr-phi-upper
map Χ = gr-chi-upper
map Ψ = gr-psi-upper
map Ω = gr-omega-upper

map α = gr-alpha-lower
map β = gr-beta-lower
map γ = gr-gamma-lower
map δ = gr-delta-lower
map ε = gr-epsilon-lower
map ζ = gr-zeta-lower
map η = gr-eta-lower
map θ = gr-theta-lower
map ι = gr-iota-lower
map κ = gr-kappa-lower
map λ = gr-lambda-lower
map μ = gr-mu-lower
map ν = gr-nu-lower
map ξ = gr-xi-lower
map ο = gr-omicron-lower
map π = gr-pi-lower
map ρ = gr-rho-lower
map σ = gr-sigma-lower
map ς = gr-sigma-final-lower
map τ = gr-tau-lower
map υ = gr-upsilon-lower
map φ = gr-phi-lower
map χ = gr-chi-lower
map ψ = gr-psi-lower
map ω = gr-omega-lower

//--------------------------------------
// combining characters

feature ccmp for grek : anchor gr-above
feature ccmp for grek : anchor gr-below

name-parts $gr-comb = tonos varia dialytika
name-parts $gr-vowel = alpha epsilon eta iota omicron upsilon omega

remap gr-comb : gr-($gr-lex)-upper : acute-above -> gr-tonos
remap gr-comb : gr-($gr-lex)-lower : acute-above -> gr-tonos
remap gr-comb : gr-($gr-comb) : acute-above -> gr-tonos

remap gr-comb : gr-($gr-lex)-upper : grave-above -> gr-varia
remap gr-comb : gr-($gr-lex)-lower : grave-above -> gr-varia
remap gr-comb : gr-($gr-comb) : grave-above -> gr-varia

remap gr-comb : gr-($gr-lex)-upper : dia-above -> gr-dialytika
remap gr-comb : gr-($gr-lex)-lower : dia-above -> gr-dialytika
remap gr-comb : gr-($gr-comb) : dia-above -> gr-dialytika

remap gr-merge : gr-dialytika(|:wide) gr-tonos -> gr-dialytika-tonos
remap gr-merge : gr-dialytika(|:wide) gr-varia -> gr-dialytika-varia

remap group gr-merge after gr-comb
feature ccmp for grek : gr-comb
feature ccmp for grek : gr-merge

//--------------------------------------
// with tonos/oxia (not distinguished)

glyph gr-tonos0 3 3
../VV'
.vV/..
/Vv'..

glyph gr-tonos mark advance 0
ref gr-tonos0
anchor -gr-above 1 1
anchor +gr-above 1 -1

glyph gr-tonos:wide mark advance 0
ref gr-tonos0
anchor -gr-above 0..1 1
anchor +gr-above 1 -1

glyph gr-($gr-vowel)-upper-with-tonos
ref gr-($gr-vowel)-upper
ref gr-tonos
glyph gr-($gr-vowel)-lower-with-tonos
ref gr-($gr-vowel)-lower
ref gr-tonos

map Ά|Ά = gr-alpha-upper-with-tonos
map Έ|Έ = gr-epsilon-upper-with-tonos
map Ή|Ή = gr-eta-upper-with-tonos
map Ί|Ί = gr-iota-upper-with-tonos
map Ό|Ό = gr-omicron-upper-with-tonos
map Ύ|Ύ = gr-upsilon-upper-with-tonos
map Ώ|Ώ = gr-omega-upper-with-tonos

map ά|ά = gr-alpha-lower-with-tonos
map έ|έ = gr-epsilon-lower-with-tonos
map ή|ή = gr-eta-lower-with-tonos
map ί|ί = gr-iota-lower-with-tonos
map ό|ό = gr-omicron-lower-with-tonos
map ύ|ύ = gr-upsilon-lower-with-tonos
map ώ|ώ = gr-omega-lower-with-tonos

assert shape Ά : gr-alpha-upper-with-tonos
assert shape Β́ : gr-beta-upper : gr-tonos offset -10 2

//--------------------------------------
// with varia

glyph gr-varia0 3 3
`VV\..
..\Vv.
..`vV\

glyph gr-varia mark advance 0
ref gr-varia0
anchor -gr-above 1 1
anchor +gr-above 1 -1

glyph gr-varia:wide mark advance 0
ref gr-varia0
anchor -gr-above 1..2 1
anchor +gr-above 1 -1

glyph gr-($gr-vowel)-upper-with-varia
ref gr-($gr-vowel)-upper
ref gr-varia
glyph gr-($gr-vowel)-lower-with-varia
ref gr-($gr-vowel)-lower
ref gr-varia

map Ὰ = gr-alpha-upper-with-varia
map Ὲ = gr-epsilon-upper-with-varia
map Ὴ = gr-eta-upper-with-varia
map Ὶ = gr-iota-upper-with-varia
map Ὸ = gr-omicron-upper-with-varia
map Ὺ = gr-upsilon-upper-with-varia
map Ὼ = gr-omega-upper-with-varia

map ὰ = gr-alpha-lower-with-varia
map ὲ = gr-epsilon-lower-with-varia
map ὴ = gr-eta-lower-with-varia
map ὶ = gr-iota-lower-with-varia
map ὸ = gr-omicron-lower-with-varia
map ὺ = gr-upsilon-lower-with-varia
map ὼ = gr-omega-lower-with-varia

//--------------------------------------
// with dialytika

glyph gr-dialytika mark
ref dia-above:narrow inherit
anchor +gr-above 2 -1

glyph gr-dialytika:wide mark
ref dia-above inherit
anchor +gr-above 2..3 -1

glyph gr-(iota|upsilon)-upper-with-dialytika
ref gr-(iota|upsilon)-upper
ref gr-dialytika
glyph gr-(iota|upsilon)-lower-with-dialytika
ref gr-(iota|upsilon)-lower
ref gr-dialytika

map Ϊ = gr-iota-upper-with-dialytika
map Ϋ = gr-upsilon-upper-with-dialytika

map ϊ = gr-iota-lower-with-dialytika
map ϋ = gr-upsilon-lower-with-dialytika

//--------------------------------------
// with dialytika + tonos

glyph gr-dialytika-tonos mark
ref dia-wide
ref gr-tonos 2 -1 inherit

glyph gr-dialytika-tonos:wide mark
ref dia-wide 0 0
ref gr-tonos0 2 -1
anchor -gr-above 2..3 0
anchor +gr-above 2..3 -2

glyph gr-(iota|upsilon)-lower-with-dialytika-tonos
ref gr-(iota|upsilon)-lower
ref gr-dialytika-tonos

map ΐ|ΐ = gr-iota-lower-with-dialytika-tonos
map ΰ|ΰ = gr-upsilon-lower-with-dialytika-tonos

//--------------------------------------
// with dialytika + varia

glyph gr-dialytika-varia mark
ref dia-wide
ref gr-varia 1 -1 inherit

glyph gr-dialytika-varia:wide mark
ref dia-wide 0 0
ref gr-varia0 1 -1
anchor -gr-above 2..3 0
anchor +gr-above 2..3 -2

glyph gr-(iota|upsilon)-lower-with-dialytika-varia
ref gr-(iota|upsilon)-lower
ref gr-dialytika-varia

map ῒ = gr-iota-lower-with-dialytika-varia
map ῢ = gr-upsilon-lower-with-dialytika-varia

//--------------------------------------
// with psili

glyph gr-psili mark
ref com-above:narrow inherit
anchor -gr-above 1 1
anchor +gr-above 1 -1

glyph gr-psili:wide mark
ref com-above inherit
anchor -gr-above 0..1 1
anchor +gr-above 0..1 -1

glyph gr-($gr-vowel)-upper-with-psili
ref gr-($gr-vowel)-upper
ref gr-psili
glyph gr-($gr-vowel|rho)-lower-with-psili
ref gr-($gr-vowel|rho)-lower
ref gr-psili

map Ἀ = gr-alpha-upper-with-psili
map Ἐ = gr-epsilon-upper-with-psili
map Ἠ = gr-eta-upper-with-psili
map Ἰ = gr-iota-upper-with-psili
map Ὀ = gr-omicron-upper-with-psili
//map ὘ = gr-upsilon-upper-with-psili
map Ὠ = gr-omega-upper-with-psili

map ἀ = gr-alpha-lower-with-psili
map ἐ = gr-epsilon-lower-with-psili
map ἠ = gr-eta-lower-with-psili
map ἰ = gr-iota-lower-with-psili
map ὀ = gr-omicron-lower-with-psili
map ὐ = gr-upsilon-lower-with-psili
map ὠ = gr-omega-lower-with-psili
map ῤ = gr-rho-lower-with-psili

