map wide|narrow : ⚺ = semisextile($-half) // 30°
map wide|narrow : ⯴ = novile($-half) // 40° (russian)
map wide|narrow : ⚹ = sextile($-half) // 60°
map wide|narrow : ⯵ = quintile($-half) // 72° (russian)
map wide|narrow : ⯶ = binovile($-half) // 80° (russian)
map wide|narrow : ⯷ = sentagon($-half) // 100° (russian)
