map wide|narrow : ☌ = conjunction($-half) // 0°
map wide|narrow : 🝵 = occultation($-half) // 0° + eclipse
map wide|narrow : ⯳ = vigintile($-half) // 18° (russian)
map wide|narrow : ⚺ = semisextile($-half) // 30°
map wide|narrow : ⯴ = novile($-half) // 40° (russian)
map wide|narrow : ⚹ = sextile($-half) // 60°
map wide|narrow : ⯵ = quintile($-half) // 72° (russian)
map wide|narrow : ⯶ = binovile($-half) // 80° (russian)
map wide|narrow : ⯷ = sentagon($-half) // 100° (russian)
map wide|narrow : ⯸ = tredecile($-half) // 108° (russian)
map wide|narrow : ⚼ = sesquiquadrate($-half) // 135°
map wide|narrow : ⚻ = quincunx($-half) // 150°
map wide|narrow : ☍ = opposition($-half) // 180°
map wide|narrow : 🝶 = lunar-eclipse($-half) // 180° + eclipse

