anchor -music-notehead 5 12
anchor +music-flag 5 1

glyph music-stem-0 = music-stem

glyph music-stem-($#1..6) 8 16 mark origin 8 0
ref music-stem-($#0..5) 8 -3
ref 1x3 5 10
anchor -music-notehead 5 12
anchor +music-flag 5 1

map 𝅥 = music-stem

