map 𝅮|𝅯|𝅰|𝅱|𝅲 = music-flag-1r(8|16|32|64|128)

map 𝉐|𝉑|𝉒 = music-flag-1r(256|512|1024)

// lengthen the stem for certain flags
remap music-note : music-stem -> music-stem-1 : music-flag-1r32
remap music-note : music-stem -> music-stem-2 : music-flag-1r64
remap music-note : music-stem -> music-stem-3 : music-flag-1r128
remap music-note : music-stem -> music-stem-4 : music-flag-1r256
remap music-note : music-stem -> music-stem-5 : music-flag-1r512
remap music-note : music-stem -> music-stem-6 : music-flag-1r1024

assert shape 𝅗𝅥𝅮 : music-notehead-void : music-stem : music-flag-1r8
assert shape 𝅗𝅥𝅯 : music-notehead-void : music-stem : music-flag-1r16
assert shape 𝅗𝅥𝅰 : music-notehead-void : music-stem-1 : music-flag-1r32
assert shape 𝅗𝅥𝅱 : music-notehead-void : music-stem-2 : music-flag-1r64
assert shape 𝅗𝅥𝅲 : music-notehead-void : music-stem-3 : music-flag-1r128
// needs Unicode 18 updates to script_run.rs
//assert shape 𝅗𝅥𝉐 : music-notehead-void : music-stem-4 : music-flag-1r256
//assert shape 𝅗𝅥𝉑 : music-notehead-void : music-stem-5 : music-flag-1r512
//assert shape 𝅗𝅥𝉒 : music-notehead-void : music-stem-6 : music-flag-1r1024

