# western musical symbols

feature ccmp for DFLT : anchor music-notehead
feature ccmp for DFLT : anchor music-dot
feature ccmp for DFLT : anchor music-flag
feature ccmp for DFLT : music-note

## notes

// atomic notes are distinguished from compound notes
// by the tilting angle (combining note head is slanted).
glyph music-notehead-atomic 4 3
/0@@@@0\
@@@@@@@@
\0@@@@0/

glyph music-note-1r4-atomic 8 16
ref music-stem
ref music-notehead-atomic 2 12

glyph music-note-1r8-atomic 8 16
ref music-stem 6 0
ref music-notehead-atomic 0 12
ref music-flag-1r8 8 0

glyph music-note-2r8-beamed 8 16
......h\........
......@@H~h\....
......@@_H@@H~h\
......@@..\h_H@@
......@@......@@
......@@......@@
......@@......@@
......@@......@@
......@@......@@
......@@......@@
......@@......@@
..............@@
..............@@
................
................
................
ref music-notehead-atomic 0 10
ref music-notehead-atomic 4 12

glyph music-note-2r16-beamed 8 16
......h\........
......@@H~h\....
......@@_H@@H~h\
......@@h\\h_H@@
......@@@@H~h\@@
......@@\h_H@@@@
......@@....\h@@
......@@......@@
......@@......@@
......@@......@@
......@@......@@
..............@@
..............@@
................
................
................
ref music-notehead-atomic 0 10
ref music-notehead-atomic 4 12

map ♩ = music-note-1r4-atomic
map ♪ = music-note-1r8-atomic
map ♫ = music-note-2r8-beamed
map ♬ = music-note-2r16-beamed

glyph music-note-1r2 8 16
ref music-stem
ref music-notehead-void

glyph music-note-1r4 8 16
ref music-stem
ref music-notehead-black

glyph music-note-1r(8|16|32) 8 16 advance 8
ref music-stem
ref music-notehead-black
ref music-flag-1r($-1)

map 𝅗𝅥 = music-note-1r2
map 𝅘𝅥 = music-note-1r4
map 𝅘𝅥𝅮 = music-note-1r8
map 𝅘𝅥𝅯 = music-note-1r16
map 𝅘𝅥𝅰 = music-note-1r32

assert distinct music-note-1r4 music-note-1r4-atomic
assert distinct music-note-1r8 music-note-1r8-atomic

