remap ascii-arrow : lt hyphen gt -> lt-and-hyphen-and-gt
remap ascii-arrow : lt hyphen -> lt-and-hyphen
remap ascii-arrow : hyphen gt -> hyphen-and-gt

remap ascii-arrow : lt eq gt -> lt-and-eq-and-gt
remap ascii-arrow : lt eq -> lt-and-eq
remap ascii-arrow : eq gt -> eq-and-gt
remap ascii-arrow : (eq-cont|lt-and-eq) : eq -> eq-cont
remap ascii-arrow-rev : eq -> eq-cont : (eq-cont|eq-and-gt)
remap group ascii-arrow-rev reversed after ascii-arrow

feature liga for DFLT : ascii-arrow
feature liga for DFLT : ascii-arrow-rev

assert shape ====> : eq-cont : eq-cont : eq-cont : eq-and-gt
assert shape <==== : lt-and-eq : eq-cont : eq-cont : eq-cont

