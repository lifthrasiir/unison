remap group tok-long
remap group tok-long-pi after tok-long

name-parts $tok-cart = $tok-all middot colon tally-1

remap tok-long : tok-pi tok-long-start -> tok-long-pi
remap tok-long : tok-cart-(start|cont) : tok-($tok-cart) -> tok-($tok-cart) tok-cart-cont
remap tok-long : tok-cart-(start|cont) : wsp -> wsp tok-cart-cont
remap tok-long-pi : tok-long-pi(|-cont) : tok-($tok-all) -> tok-($tok-all) tok-long-pi-cont

// long pi should work, as in `jan pi oko lape` (the author's name)
