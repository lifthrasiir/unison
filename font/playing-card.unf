ref card-tarot-border-half fill card-border

glyph card-tarot-($1..9)
ref card-fill fill card-white
ref card-tarot-border fill card-border
ref sm-($1..9) 7 5 fill card-black
glyph card-tarot-1($0..9)
ref card-fill fill card-white
ref card-tarot-border fill card-border
ref sm-1 5 5 fill card-black
ref sm-($0..9) 9 5 fill card-black
glyph card-tarot-2(0|1)
ref card-fill fill card-white
ref card-tarot-border fill card-border
ref sm-2 5 5 fill card-black
ref sm-(0|1) 9 5 fill card-black

glyph card-tarot-($1..9)-half
ref card-fill-half fill card-white
ref card-tarot-border-half fill card-border
ref sm-($1..9)-4x5 2 5 fill card-black
glyph card-tarot-1($0..9)-half
ref card-fill-half fill card-white
ref card-tarot-border-half fill card-border
ref sm-1 1 5 fill card-black
ref sm-($0..9) 4 5 fill card-black
glyph card-tarot-2(0|1)-half
ref card-fill-half fill card-white
ref card-tarot-border-half fill card-border
ref sm-2 1 5 fill card-black
ref sm-(0|1) 4 5 fill card-black

map wide|narrow : U+1F0E0 = card-tarot-blank($-half)
map wide|narrow : U+1F0E1..1F0F5 = card-tarot-($1..21)($-half)

