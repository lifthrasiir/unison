glyph card-joker-red 16 16
ref card-border fill card-border
ref card-fill fill card-red coloronly
ref card-joker fill card-white coloronly
ref card-joker-half-fill fill fg monoonly
glyph @-half 8 16
ref card-border-half fill card-border
ref card-fill-half fill card-red coloronly
ref card-joker-half fill card-white coloronly
ref card-joker-half-fill-half fill fg monoonly

glyph card-spade-($card-rank)
ref card-border fill card-border
ref card-fill fill card-white
ref card-suit-spade fill card-black
ref card-rank-($card-rank) fill card-black
glyph @-half
ref card-border-half fill card-border
ref card-fill-half fill card-white
ref card-suit-spade-half fill card-black
ref card-rank-($card-rank)-half fill card-black

glyph card-heart-($card-rank)
ref card-border fill card-border
ref card-fill fill card-white
ref card-suit-heart fill card-red
ref card-rank-($card-rank) fill card-black
glyph @-half
ref card-border-half fill card-border
ref card-fill-half fill card-white
ref card-suit-heart-half fill card-red
ref card-rank-($card-rank)-half fill card-black

glyph card-diamond-($card-rank)
ref card-border fill card-border
ref card-fill fill card-white
ref card-suit-diamond fill card-red
ref card-rank-($card-rank) fill card-black
glyph @-half
ref card-border-half fill card-border
ref card-fill-half fill card-white
ref card-suit-diamond-half fill card-red
ref card-rank-($card-rank)-half fill card-black

glyph card-club-($card-rank)
ref card-border fill card-border
ref card-fill fill card-white
ref card-suit-club fill card-black
ref card-rank-($card-rank) fill card-black
glyph @-half
ref card-border-half fill card-border
ref card-fill-half fill card-white
ref card-suit-club-half fill card-black
ref card-rank-($card-rank)-half fill card-black

map wide|narrow : U+1F0A0 = card-back($-half)
map wide|narrow : U+1F0A1..1F0AE = card-spade-($card-rank)($-half)
map wide|narrow : U+1F0B1..1F0BE = card-heart-($card-rank)($-half)
map wide|narrow : U+1F0C1..1F0CE = card-diamond-($card-rank)($-half)
map wide|narrow : U+1F0D1..1F0DE = card-club-($card-rank)($-half)
map wide|narrow : U+1F0BF = card-joker-red($-half)
map wide|narrow : U+1F0CF = card-joker-black($-half)
map wide|narrow : U+1F0DF = card-joker-white($-half)

