glyph card-joker-red 16 16
ref card-border fill card-border
ref card-fill fill card-red coloronly
ref card-joker fill card-white coloronly
ref card-joker-half-fill fill fg monoonly

glyph card-spade-($card-rank)
ref card-border fill card-border
ref card-fill fill card-white
ref card-suit-spade fill card-black
ref card-rank-($card-rank) fill card-black

glyph card-heart-($card-rank)
ref card-border fill card-border
ref card-fill fill card-white
ref card-suit-heart fill card-red
ref card-rank-($card-rank) fill card-black

glyph card-diamond-($card-rank)
ref card-border fill card-border
ref card-fill fill card-white
ref card-suit-diamond fill card-red
ref card-rank-($card-rank) fill card-black

glyph card-club-($card-rank)
ref card-border fill card-border
ref card-fill fill card-white
ref card-suit-club fill card-black
ref card-rank-($card-rank) fill card-black

map U+1F0A0 = card-back
map U+1F0A1..1F0AE = card-spade-($card-rank)
map U+1F0B1..1F0BE = card-heart-($card-rank)
map U+1F0C1..1F0CE = card-diamond-($card-rank)
map U+1F0D1..1F0DE = card-club-($card-rank)
map U+1F0BF = card-joker-red
map U+1F0CF = card-joker-black
map U+1F0DF = card-joker-white

//--------------------------------------
// tarot decks

glyph card-tarot-border 16 16
................................
..../0@@@@@@@@@@@@@@@@@@@@@@0\..
....@@../01/..........\10\..@@..
....@@/01/..............\10\@@..
....@@1/..................\1@@..
....@@......................@@..
....@@......................@@..
....@@......................@@..
....@@......................@@..
....@@......................@@..
....@@......................@@..
....@@1\................../1@@..
....@@\01\............../10/@@..
....@@..\01\........../10/..@@..
....\0@@@@@@@@@@@@@@@@@@@@@@0/..
................................

glyph card-tarot-blank 16 16
ref card-fill fill card-white
ref card-tarot-border fill card-border

glyph card-tarot-($1..9)
ref card-fill fill card-white
ref card-tarot-border fill card-border
ref sm-($1..9) 7 5 fill card-black

glyph card-tarot-1($0..9)
ref card-fill fill card-white
ref card-tarot-border fill card-border
ref sm-1 5 5 fill card-black
ref sm-($0..9) 9 5 fill card-black

glyph card-tarot-2(0|1)
ref card-fill fill card-white
ref card-tarot-border fill card-border
ref sm-2 5 5 fill card-black
ref sm-(0|1) 9 5 fill card-black

map U+1F0E0 = card-tarot-blank
map U+1F0E1..1F0F5 = card-tarot-($1..21)

