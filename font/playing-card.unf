////////////////////////////////////////
// playing cards

name-parts $card-rank = a 2 3 4 5 6 7 8 9 10 j kn q k

//--------------------------------------
// 56-card decks

color card-border = #404040
color card-white = #ffffff coloronly
color card-black = #000000
color card-red = #ff0000

