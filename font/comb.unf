## breve

glyph breve 5 2
@@1\../1@@
\0@@@@@@0/

glyph breve-above mark advance 0 left -2 top 0
ref breve
anchor -above 2 1
anchor +above 2 -1

glyph breve-above:wide mark
ref breve
anchor -above 1..2 1
anchor +above 1..2 -1

// unlike the circumflex below, the breve below opens away from the letter, so
// its first row is the one that meets the base
glyph breve-below mark advance 0 left -2 top 14
ref breve
anchor -below 2 0
anchor +below 2 2

glyph breve-below:wide mark
ref breve
anchor -below 1..2 0
anchor +below 1..2 2

map U+0306 = breve-above
map U+032E = breve-below

glyph breve-above-spacing
ref sp
ref breve 2 0

map ˘ = breve-above-spacing

