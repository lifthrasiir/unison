## tests

// i + combining marks
assert shape ï : uni00EF
assert shape i̤ : i-lower : dia-below offset -4 0
assert shape ï̈ : uni00EF : dia-above offset -4 1
assert shape i̤̤ : i-lower : dia-below offset -4 0 : dia-below offset -4 2
assert shape ï̤ : uni00EF : dia-below offset -4 0
assert shape ï̤ : uni00EF : dia-below offset -4 0

// Every `map generate` i-composite stacks its own mark once more: the second
// mark can only land on the `+above` the first one published, so a wrong
// offset here means the generated glyph composed over dotted `i-lower`
// instead of `i-lower:dotless`. `ï̈` above caught exactly that once.
assert shape í́ : uni00ED : acute-above:wide offset -6 1
assert shape ì̀ : uni00EC : grave-above:wide offset -6 1
assert shape ī̄ : uni012B : mac-above:narrow offset -6 2
assert shape ǐ̌ : uni01D0 : caron-above:wide offset -6 1
assert shape î̂ : uni00EE : circ-above:wide offset -6 1
assert shape ĭ̆ : uni012D : breve-above:wide offset -6 1
assert shape ĩ̃ : uni0129 : tilde-above:wide offset -6 1

// j + combining marks
assert shape j̈ : j-lower:dotless : dia-above:narrow offset -5 3
assert shape j̤ : j-lower:compressed : dia-below:narrow offset -6 14
assert shape j̈̈ : j-lower:dotless : dia-above:narrow offset -5 3 : dia-above:narrow offset -5 1
assert shape j̤̤ : j-lower:compressed : dia-below:narrow offset -6 14 : dia-below:narrow offset -6 16
// TODO j + U+0308 + U+0324 and j + U+0324 + U+0308 (needs compressed+dotless variant)

// marks that have no precomposed form on the base below, so the shaper really
// does have to attach them through the anchors
assert shape b̂ : b-lower : circ-above offset -4 1
assert shape b̌ : b-lower : caron-above offset -4 1
assert shape u̇ : u-lower : dot-above offset -3 2
assert shape p̃ : p-lower : tilde-above offset -4 2
assert shape b̨ : b-lower : ogonek-below offset -3 0
assert shape f̊ : f-lower : ring-above offset -4 0
assert shape m̉ : m-lower : hook-above offset -4 2
assert shape m̭ : m-lower : circ-below offset -4 -1
assert shape m̮ : m-lower : breve-below offset -4 0
assert shape m̑ : m-lower : arch-above offset -4 2
assert shape m̥ : m-lower : ring-below offset -4 0
assert shape m̰ : m-lower : tilde-below offset -4 0
// a two-cell +above anchor picks the `:wide` alternative
assert shape ı̂ : i-lower:dotless : circ-above:wide offset -6 3
assert shape ı́ : i-lower:dotless : acute-above:wide offset -6 3

