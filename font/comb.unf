# combining marks

feature ccmp for DFLT : anchor below
feature ccmp for DFLT : anchor above

## diaeresis

glyph dia-narrow 5 2 inline
/01\../10\
\01/..\10/

glyph dia-wide 6 2 inline
/01\..../10\
\01/....\10/

glyph dia-below:narrow mark
ref dia-narrow
anchor -below 2 0
anchor +below 2 2

glyph dia-below mark advance 0 left -3 top 14
ref dia-wide
anchor -below 2..3 0
anchor +below 2..3 2

glyph dia-above:narrow mark
ref dia-narrow
anchor -above 2 1
anchor +above 2 -1

glyph dia-above mark advance 0 left -3 top 0
ref dia-wide
anchor -above 2..3 1
anchor +above 2..3 -1

map U+0308 = dia-above
map U+0324 = dia-below

glyph dia-above-spacing
ref sp
ref dia-below:narrow 2 0

map ¨ = dia-above-spacing

## acute accents

// shared with Polish kreska, which is steeper than acute
// but such fine distinction is hard in bitmaps anyway.

glyph acute-left 4 2 inline
../1@@0/
/1@@0/..

glyph acute-right 4 2 inline
../0@@1/
/0@@1/..

glyph acute-below mark advance 0 left -2 top 14
ref acute-right
anchor -below 2 0
anchor +below 2 2

glyph acute-below:wide mark
ref acute-left
anchor -below 1..2 0
anchor +below 1..2 2

glyph acute-above mark advance 0 left -2 top 0
ref acute-left
anchor -above 1 1
anchor +above 1 -1

glyph acute-above:wide mark
ref acute-right
anchor -above 1..2 1
anchor +above 1..2 -1

map U+0301 = acute-above
map U+0317 = acute-below

glyph acute-above-spacing
ref sp
ref acute-right 2 0

glyph acute-below-spacing
ref sp
ref acute-right 2 14

map ´ = acute-above-spacing // symbol, provides break opportunity
map ˊ = acute-above-spacing // modifier, cannot be broken
map ˏ = acute-below-spacing

## double acute accents

glyph dacute-above mark advance 0 left -3
ref acute-right 0 0
ref acute-right 3 0
anchor -above 3 1
anchor +above 3 -1

glyph dacute-above:wide mark
ref acute-left 0 0
ref acute-left 3 0
anchor -above 3..4 1
anchor +above 3..4 -1

map U+030B = dacute-above

glyph dacute-above-spacing
ref sp
ref acute-left 1 0
ref acute-left 4 0

map ˝ = dacute-above-spacing

