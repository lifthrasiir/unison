////////////////////////////////////////
// combining marks

feature ccmp for DFLT : anchor below
feature ccmp for DFLT : anchor above

//--------------------------------------
// diaeresis

glyph dia-narrow 5 2 inline
/01\../10\
\01/..\10/

glyph dia-wide 6 2 inline
/01\..../10\
\01/....\10/

glyph dia-below:narrow mark
ref dia-narrow
anchor -below 2 0
anchor +below 2 2

glyph dia-below mark advance 0 left -3 top 14
ref dia-wide
anchor -below 2..3 0
anchor +below 2..3 2

glyph dia-above:narrow mark
ref dia-narrow
anchor -above 2 1
anchor +above 2 -1

glyph dia-above mark advance 0 left -3 top 0
ref dia-wide
anchor -above 2..3 1
anchor +above 2..3 -1

map U+0308 = dia-above
map U+0324 = dia-below

glyph dia-above-spacing
ref sp
ref dia-below:narrow 2 0

map ¨ = dia-above-spacing

//--------------------------------------
// acute accents
//
// shared with Polish kreska, which is steeper than acute
// but such fine distinction is hard in bitmaps anyway.

glyph acute-left 4 2 inline
../1@@0/
/1@@0/..

glyph acute-right 4 2 inline
../0@@1/
/0@@1/..

glyph acute-below mark
ref acute-right
anchor -below 2 0
anchor +below 2 2

glyph acute-below:wide mark
ref acute-left
anchor -below 1..2 0
anchor +below 1..2 2

glyph acute-lower-shift
ref acute-right

glyph acute-above mark
ref acute-left
anchor -above 1 1
anchor +above 1 -1

glyph acute-above:wide mark
ref acute-right
anchor -above 1..2 1
anchor +above 1..2 -1

map U+0301 = acute-above
map U+0317 = acute-below

glyph acute-above-spacing
ref sp
ref acute-left 3 0
map ´ = acute-above-spacing

//--------------------------------------
// double acute accents

glyph dacute-above mark
ref acute-right 0 0
ref acute-right 3 0
anchor -above 3 1
anchor +above 3 -1

glyph dacute-above:wide mark
ref acute-left 0 0
ref acute-left 3 0
anchor -above 3..4 1
anchor +above 3..4 -1

map U+030B = dacute-above

//--------------------------------------
// grave accents

glyph grave-lower 4 2
\0@@1\..
..\0@@1\

glyph grave-lower-shift 4 2
\1@@0\..
..\1@@0\

glyph grave-upper 4 2
ref grave-lower 0 0

//--------------------------------------
// double grave accents

glyph dgrave-lower 7 2
ref grave-lower-shift 0 0
ref grave-lower-shift 3 0

glyph dgrave-upper 7 2
ref dgrave-lower 0 0

//--------------------------------------
// macrons

glyph mac-lower 5 1
@@@@@@@@@@

glyph mac-upper 5 1
ref mac-lower 0 0

glyph mac-lower-sm 4 1
@@@@@@@@

glyph mac-upper-sm 4 1
ref mac-lower-sm 0 0

glyph mac-bottom 5 1
ref mac-lower 0 0

glyph mac-bottom-sm 4 1
ref mac-lower-sm 0 0

glyph uni00AF
ref sp
ref mac-lower 2 3
map ¯ = uni00AF

//--------------------------------------
// cedilla/comma

// intended to look like a comma as well
// (the choice between cedilla and comma is ultimately a locale matter
// that is hard to resolve within a single font anyway)
glyph ced 2 3
@@@@
\0@@
@@0/

glyph ced-inverted-lower 2 3
/0@@
@@0\
@@@@

glyph uni00B8
ref sp
ref ced 4 13
map ¸ = uni00B8

//--------------------------------------
// ogonek

glyph ogonek 2 3
/01/
1<..
\1@@

//--------------------------------------
// caron (hacek)

glyph caron-lower 5 2
\01\../10/
..\0@@0/..

glyph caron-upper 5 2
ref caron-lower 0 0

// looks like a comma, used for czech and slovak
glyph caron-alt 2 3
@@@@
\0@@
@@0/

//--------------------------------------
// circumflex

glyph circ 5 2
../0@@0\..
/01/..\10\

glyph circ-lower
ref circ

glyph circ-upper
ref circ

glyph circ-bottom
ref circ

//--------------------------------------
// breve

glyph breve 5 2
@@1\../1@@
\0@@@@@@0/

glyph breve-lower
ref breve

glyph breve-upper
ref breve

glyph breve-bottom
ref breve

//--------------------------------------
// inverted breve (arch)

glyph arch 5 2
/0@@@@@@0\
@@1/..\1@@

glyph arch-lower
ref arch

glyph arch-upper
ref arch

//--------------------------------------
// ring

glyph ring 3 3
/0@@0\
@@..@@
\0@@0/

glyph ring-lower
ref ring

glyph ring-upper
ref ring

glyph ring-bottom
ref ring

//--------------------------------------
// tilde

glyph comb-tilde 5 2
/0@@1\../1
1/..\1@@0/

glyph tilde-lower
ref comb-tilde

glyph tilde-upper
ref comb-tilde

glyph tilde-bottom
ref comb-tilde

//--------------------------------------
// dot

glyph comb-dot 2 2
@@@@
@@@@

glyph dot-lower
ref comb-dot

glyph dot-upper 2 2
ref comb-dot

glyph dot-bottom 2 2
ref comb-dot

glyph dot-middle 2 2
ref comb-dot

//--------------------------------------
// hook above

glyph hook 3 3
/1@@1\
0/..@@
../10/

glyph hook-lower
ref hook

glyph hook-upper
ref hook

