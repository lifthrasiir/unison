////////////////////////////////////////
// combining marks

feature ccmp for DFLT : anchor below
feature ccmp for DFLT : anchor above

//--------------------------------------
// diaeresis

glyph dia-narrow 5 2 inline
/01\../10\
\01/..\10/

glyph dia-wide 6 2 inline
/01\..../10\
\01/....\10/

glyph dia-below:narrow mark
ref dia-narrow
anchor -below 2 0
anchor +below 2 2

glyph dia-below mark advance 0 left -3 top 14
ref dia-wide
anchor -below 2..3 0
anchor +below 2..3 2

glyph dia-above:narrow mark
ref dia-narrow
anchor -above 2 1
anchor +above 2 -1

glyph dia-above mark advance 0 left -3 top 0
ref dia-wide
anchor -above 2..3 1
anchor +above 2..3 -1

map U+0308 = dia-above
map U+0324 = dia-below

glyph dia-above-spacing
ref sp
ref dia-below:narrow 2 0

map ¨ = dia-above-spacing

//--------------------------------------
// acute accents
//
// shared with Polish kreska, which is steeper than acute
// but such fine distinction is hard in bitmaps anyway.

glyph acute-left 4 2 inline
../1@@0/
/1@@0/..

glyph acute-right 4 2 inline
../0@@1/
/0@@1/..

glyph acute-below mark
ref acute-right
anchor -below 2 0
anchor +below 2 2

glyph acute-below:wide mark
ref acute-left
anchor -below 1..2 0
anchor +below 1..2 2

glyph acute-above mark
ref acute-left
anchor -above 1 1
anchor +above 1 -1

glyph acute-above:wide mark
ref acute-right
anchor -above 1..2 1
anchor +above 1..2 -1

map U+0301 = acute-above
map U+0317 = acute-below

glyph acute-above-spacing
ref sp
ref acute-left 3 0
map ´ = acute-above-spacing

//--------------------------------------
// double acute accents

glyph dacute-above mark
ref acute-right 0 0
ref acute-right 3 0
anchor -above 3 1
anchor +above 3 -1

glyph dacute-above:wide mark
ref acute-left 0 0
ref acute-left 3 0
anchor -above 3..4 1
anchor +above 3..4 -1

map U+030B = dacute-above

//--------------------------------------
// grave accents

glyph grave-right 4 2 inline
\0@@1\..
..\0@@1\

glyph grave-left 4 2 inline
\1@@0\..
..\1@@0\

glyph grave-below mark
ref grave-right
anchor -below 2 0
anchor +below 2 2

glyph grave-below:wide mark
ref grave-left
anchor -below 1..2 0
anchor +below 1..2 2

glyph grave-above mark
ref grave-left
anchor -above 1 1
anchor +above 1 -1

glyph grave-above:wide mark
ref grave-right
anchor -above 1..2 1
anchor +above 1..2 -1

map U+0300 = grave-above
map U+0316 = grave-below

//--------------------------------------
// double grave accents

glyph dgrave-above mark
ref grave-left 0 0
ref grave-left 3 0
anchor -above 3 1
anchor +above 3 -1

glyph dgrave-above:wide mark
ref grave-right 0 0
ref grave-right 3 0
anchor -above 2..3 1
anchor +above 2..3 -1

map U+030F = dgrave-above

//--------------------------------------
// macrons

glyph mac-wide 5 1
@@@@@@@@@@

glyph mac-narrow 4 1
@@@@@@@@

glyph mac-above 5 1 mark
ref mac-wide
anchor -above 2 0
anchor +above 2 -2

glyph mac-above:narrow 4 1 mark
ref mac-narrow
anchor -above 1..2 0
anchor +above 1..2 -2

glyph mac-below 5 1 mark
ref mac-wide
anchor -below 2 0
anchor +below 2 2

glyph mac-below:narrow 4 1 mark
ref mac-narrow
anchor -below 1..2 0
anchor +below 1..2 2

map U+0304 = mac-above
map U+0331 = mac-below

glyph mac-above-spacing
ref sp
ref mac-wide 2 3
map ¯ = mac-above-spacing

//--------------------------------------
// cedilla/comma
//
// Unicode's handling of cedilla vs. comma is quite unusual:
// it encodes separate codepoints for combining cedilla and comma,
// but precomposed characters almost always use cedilla in normalization.
// (the only exceptions are S and T plus comma below, for disambiguation.)
// therefore *some* cedilla combinations have to be rendered as comma
// regardless of their decompositions.

glyph ced 3 3
..@@@@
..\0@@
@@@@0/

glyph com 2 3
@@@@
\0@@
@@0/

glyph com-reversed 2 3
@@@@
@@0/
\0@@

glyph com-inverted 2 3
/0@@
@@0\
@@@@

glyph ced-above mark
ref ced
anchor -above 1 2
anchor +above 1 -1

glyph ced-above:wide mark
ref ced
anchor -above 1..2 2
anchor +above 1..2 -1

// the below marks hang three rows deep, but a base's +below anchor only
// leaves two rows inside the em box.  so the attachment row is the mark's
// *second* row: its top row is the stroke that meets the letter's own last
// row, which is where these have always been drawn.
glyph ced-below mark
ref ced
anchor -below 1 1
anchor +below 1 4

glyph ced-below:wide mark
ref ced
anchor -below 1..2 1
anchor +below 1..2 4

glyph com-above mark
ref com
anchor -above 0..1 2
anchor +above 0..1 -1

glyph com-above:narrow mark
ref com
anchor -above 1 2
anchor +above 1 -1

glyph com-reversed-above mark
ref com-reversed
anchor -above 0..1 2
anchor +above 0..1 -1

glyph com-reversed-above:narrow mark
ref com-reversed
anchor -above 1 2
anchor +above 1 -1

// U+0312 is the latvian ģ mark: an attached mark, not a floating accent, so
// unlike the breathing marks above it sits flush with the letter (one row
// lower) and follows the comma family's column instead of being centered.
glyph com-inverted-above mark
ref com-inverted
anchor -above 0..1 1
anchor +above 0..1 -1

glyph com-inverted-above:narrow mark
ref com-inverted
anchor -above 0 1
anchor +above 0 -1

glyph com-below mark
ref com
anchor -below 0 1
anchor +below 0 4

glyph com-below:wide mark
ref com
anchor -below 0..1 1
anchor +below 0..1 4

map U+0312 = com-inverted-above
map U+0313 = com-above
map U+0314 = com-reversed-above
map U+0326 = com-below
map U+0327 = ced-below

glyph ced-below-spacing
ref sp
ref ced 3 13
map ¸ = ced-below-spacing

//--------------------------------------
// ogonek

glyph ogonek 2 3
/01/
1<..
\1@@

// like the cedilla, the ogonek hangs three rows deep while a base's +below
// anchor only reaches two rows into the em box, so the attachment row is the
// mark's *second* row.
glyph ogonek-below mark
ref ogonek
anchor -below 0 1
anchor +below 0 4

glyph ogonek-below:wide mark
ref ogonek
anchor -below 0..1 1
anchor +below 0..1 4

map U+0328 = ogonek-below

//--------------------------------------
// caron (hacek)

glyph caron 5 2
\01\../10/
..\0@@0/..

glyph caron-above mark
ref caron
anchor -above 2 1
anchor +above 2 -1

glyph caron-above:wide mark
ref caron
anchor -above 1..2 1
anchor +above 1..2 -1

map U+030C = caron-above

// looks like a comma, used for czech and slovak.  it is a positional variant
// of the caron rather than a mark of its own: it has no anchors because it
// hangs off the letter's right side, which no +above/+below anchor describes.
glyph caron-alt 2 3
@@@@
\0@@
@@0/

//--------------------------------------
// circumflex

glyph circ 5 2
../0@@0\..
/01/..\10\

glyph circ-above mark
ref circ
anchor -above 2 1
anchor +above 2 -1

glyph circ-above:wide mark
ref circ
anchor -above 1..2 1
anchor +above 1..2 -1

glyph circ-below mark
ref circ
anchor -below 2 1
anchor +below 2 3

glyph circ-below:wide mark
ref circ
anchor -below 1..2 1
anchor +below 1..2 3

map U+0302 = circ-above
map U+032D = circ-below

//--------------------------------------
// breve

glyph breve 5 2
@@1\../1@@
\0@@@@@@0/

glyph breve-above mark
ref breve
anchor -above 2 1
anchor +above 2 -1

glyph breve-above:wide mark
ref breve
anchor -above 1..2 1
anchor +above 1..2 -1

// unlike the circumflex below, the breve below opens away from the letter, so
// its first row is the one that meets the base
glyph breve-below mark
ref breve
anchor -below 2 0
anchor +below 2 2

glyph breve-below:wide mark
ref breve
anchor -below 1..2 0
anchor +below 1..2 2

map U+0306 = breve-above
map U+032E = breve-below

//--------------------------------------
// inverted breve (arch)

glyph arch 5 2
/0@@@@@@0\
@@1/..\1@@

glyph arch-above mark
ref arch
anchor -above 2 1
anchor +above 2 -1

glyph arch-above:wide mark
ref arch
anchor -above 1..2 1
anchor +above 1..2 -1

map U+0311 = arch-above

//--------------------------------------
// ring

glyph ring 3 3
/0@@0\
@@..@@
\0@@0/

glyph ring-above mark
ref ring
anchor -above 1 1
anchor +above 1 -2

glyph ring-above:wide mark
ref ring
anchor -above 1..2 1
anchor +above 1..2 -2

glyph ring-below mark
ref ring
anchor -below 1 1
anchor +below 1 4

glyph ring-below:wide mark
ref ring
anchor -below 1..2 1
anchor +below 1..2 4

map U+030A = ring-above
map U+0325 = ring-below

//--------------------------------------
// tilde

glyph comb-tilde 5 2
/0@@1\../1
1/..\1@@0/

glyph tilde-above mark
ref comb-tilde
anchor -above 2 1
anchor +above 2 -1

glyph tilde-above:wide mark
ref comb-tilde
anchor -above 1..2 1
anchor +above 1..2 -1

glyph tilde-below mark
ref comb-tilde
anchor -below 2 0
anchor +below 2 2

glyph tilde-below:wide mark
ref comb-tilde
anchor -below 2..3 0
anchor +below 2..3 2

map U+0303 = tilde-above
map U+0330 = tilde-below

//--------------------------------------
// dot

glyph comb-dot 2 2
@@@@
@@@@

glyph dot-middle 2 2
ref comb-dot

glyph dot-above mark
ref comb-dot
anchor -above 0 1
anchor +above 0 -1

glyph dot-above:wide mark
ref comb-dot
anchor -above 0..1 1
anchor +above 0..1 -1

glyph dot-below mark
ref comb-dot
anchor -below 0 0
anchor +below 0 2

glyph dot-below:wide mark
ref comb-dot
anchor -below 0..1 0
anchor +below 0..1 2

map U+0307 = dot-above
map U+0323 = dot-below

//--------------------------------------
// hook above

glyph hook 3 3
/1@@1\
0/..@@
../10/

glyph hook-above mark
ref hook
anchor -above 1 1
anchor +above 1 -2

glyph hook-above:wide mark
ref hook
anchor -above 0..1 1
anchor +above 0..1 -2

map U+0309 = hook-above

//--------------------------------------
// tests

// i + combining marks
assert shape ï : uni00EF
assert shape i̤ : i-lower : dia-below offset -4 0
assert shape ï̈ : uni00EF : dia-above offset -4 1
assert shape i̤̤ : i-lower : dia-below offset -4 0 : dia-below offset -4 2
assert shape ï̤ : uni00EF : dia-below offset -4 0
assert shape ï̤ : uni00EF : dia-below offset -4 0

// j + combining marks
assert shape j̈ : j-lower:dotless : dia-above:narrow offset -5 3
assert shape j̤ : j-lower:compressed : dia-below:narrow offset -6 14
assert shape j̈̈ : j-lower:dotless : dia-above:narrow offset -5 3 : dia-above:narrow offset -5 1
assert shape j̤̤ : j-lower:compressed : dia-below:narrow offset -6 14 : dia-below:narrow offset -6 16
// TODO j + U+0308 + U+0324 and j + U+0324 + U+0308 (needs compressed+dotless variant)

// marks that have no precomposed form on the base below, so the shaper really
// does have to attach them through the anchors
assert shape b̂ : b-lower : circ-above offset -6 1
assert shape b̌ : b-lower : caron-above offset -6 1
assert shape u̇ : u-lower : dot-above offset -4 2
assert shape p̃ : p-lower : tilde-above offset -6 2
assert shape b̨ : b-lower : ogonek-below offset -4 13
assert shape f̊ : f-lower : ring-above offset -5 0
assert shape m̉ : m-lower : hook-above offset -5 2
assert shape m̭ : m-lower : circ-below offset -6 13
assert shape m̮ : m-lower : breve-below offset -6 14
assert shape m̑ : m-lower : arch-above offset -6 2
assert shape m̥ : m-lower : ring-below offset -5 13
assert shape m̰ : m-lower : tilde-below offset -6 14
// a two-cell +above anchor picks the `:wide` alternative
assert shape ı̂ : i-lower:dotless : circ-above:wide offset -6 3
assert shape ı́ : i-lower:dotless : acute-above:wide offset -6 3

