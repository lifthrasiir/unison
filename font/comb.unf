## macrons

glyph mac-wide 5 1
@@@@@@@@@@

glyph mac-narrow 4 1
@@@@@@@@

glyph mac-above 5 1 mark advance 0 left -2 top 0
ref mac-wide
anchor -above 2 0
anchor +above 2 -2

glyph mac-above:narrow 4 1 mark
ref mac-narrow
anchor -above 1..2 0
anchor +above 1..2 -2

glyph mac-below 5 1 mark advance 0 left -2 top 14
ref mac-wide
anchor -below 2 0
anchor +below 2 2

glyph mac-below:narrow 4 1 mark
ref mac-narrow
anchor -below 1..2 0
anchor +below 1..2 2

map U+0304 = mac-above
map U+0331 = mac-below

glyph mac-above-spacing
ref sp
ref mac-wide 2 3
map ¯ = mac-above-spacing

## cedilla/comma

// Unicode's handling of cedilla vs. comma is quite unusual:
// it encodes separate codepoints for combining cedilla and comma,
// but precomposed characters almost always use cedilla in normalization.
// (the only exceptions are S and T plus comma below, for disambiguation.)
// therefore *some* cedilla combinations have to be rendered as comma
// regardless of their decompositions.

glyph ced 3 3
..@@@@
..\0@@
@@@@0/

glyph com 2 3
@@@@
\0@@
@@0/

glyph com-reversed 2 3
@@@@
@@0/
\0@@

glyph com-turned 2 3
/0@@
@@0\
@@@@

glyph ced-above mark advance 0 left -1 top 0
ref ced
anchor -above 1 2
anchor +above 1 -1

glyph ced-above:wide mark
ref ced
anchor -above 1..2 2
anchor +above 1..2 -1

// the below marks hang three rows deep, but a base's +below anchor only
// leaves two rows inside the em box.  so the attachment row is the mark's
// *second* row: its top row is the stroke that meets the letter's own last
// row, which is where these have always been drawn.
glyph ced-below mark advance 0 left -1 top 13
ref ced
anchor -below 1 1
anchor +below 1 4

glyph ced-below:wide mark
ref ced
anchor -below 1..2 1
anchor +below 1..2 4

glyph com-above mark advance 0 left -1 top 0
ref com
anchor -above 0..1 2
anchor +above 0..1 -1

glyph com-above:narrow mark
ref com
anchor -above 1 2
anchor +above 1 -1

glyph com-reversed-above mark advance 0 left -1 top 0
ref com-reversed
anchor -above 0..1 2
anchor +above 0..1 -1

glyph com-reversed-above:narrow mark
ref com-reversed
anchor -above 1 2
anchor +above 1 -1

// U+0312 is the latvian ģ mark: an attached mark, not a floating accent, so
// unlike the breathing marks above it sits flush with the letter (one row
// lower) and follows the comma family's column instead of being centered.
glyph com-turned-above mark advance 0 left -1 top 0
ref com-turned
anchor -above 0..1 1
anchor +above 0..1 -1

glyph com-turned-above:narrow mark
ref com-turned
anchor -above 0 1
anchor +above 0 -1

glyph com-below mark advance 0 left -1 top 13
ref com
anchor -below 0 1
anchor +below 0 4

glyph com-below:wide mark
ref com
anchor -below 0..1 1
anchor +below 0..1 4

map U+0312 = com-turned-above
map U+0313 = com-above
map U+0314 = com-reversed-above
map U+0326 = com-below
map U+0327 = ced-below

glyph ced-below-spacing
ref sp
ref ced 3 13

glyph com-above-spacing
ref sp
ref com 3 0

glyph com-turned-above-spacing
ref sp
ref com-turned 3 0

glyph com-reversed-above-spacing
ref sp
ref com-reversed 3 0

assert distinct com-above-spacing quote-6
assert distinct com-turned-above-spacing quote-9
assert distinct com-reversed-above-spacing quote-9-reversed

map ¸ = ced-below-spacing
map ʻ = com-above-spacing
map ʼ = com-turned-above-spacing
map ʽ = com-reversed-above-spacing

## ogonek

glyph ogonek 2 3
/01/
1<..
\1@@

// like the cedilla, the ogonek hangs three rows deep while a base's +below
// anchor only reaches two rows into the em box, so the attachment row is the
// mark's *second* row.
glyph ogonek-below mark advance 0 left -1 top 13
ref ogonek
anchor -below 0 1
anchor +below 0 4

glyph ogonek-below:wide mark
ref ogonek
anchor -below 0..1 1
anchor +below 0..1 4

map U+0328 = ogonek-below

glyph ogonek-below-spacing
ref sp
ref ogonek-below 3 13

map ˛ = ogonek-below-spacing

## caron (hacek)

glyph caron 5 2
\01\../10/
..\0@@0/..

glyph caron-above mark advance 0 left -2 top 0
ref caron
anchor -above 2 1
anchor +above 2 -1

glyph caron-above:wide mark
ref caron
anchor -above 1..2 1
anchor +above 1..2 -1

map U+030C = caron-above

// identical to com, used for czech and slovak
// attached from the letter's right side, unlike `above` anchor
glyph caron-alt 2 3
@@@@
\0@@
@@0/

glyph caron-above-spacing
ref sp
ref caron 2 0

map ˇ = caron-above-spacing

