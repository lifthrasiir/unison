////////////////////////////////////////
// combining marks

feature ccmp for DFLT : anchor below
feature ccmp for DFLT : anchor above

//--------------------------------------
// diaeresis

glyph dia-narrow 5 2 inline
/01\../10\
\01/..\10/

glyph dia-wide 6 2 inline
/01\..../10\
\01/....\10/

glyph dia-below:narrow mark
ref dia-narrow
anchor -below 2 0
anchor +below 2 2

glyph dia-below mark advance 0 left -3 top 14
ref dia-wide
anchor -below 2..3 0
anchor +below 2..3 2

glyph dia-above:narrow mark
ref dia-narrow
anchor -above 2 1
anchor +above 2 -1

glyph dia-above mark advance 0 left -3 top 0
ref dia-wide
anchor -above 2..3 1
anchor +above 2..3 -1

map U+0308 = dia-above
map U+0324 = dia-below

glyph dia-above-spacing
ref sp
ref dia-below:narrow 2 0

map ¨ = dia-above-spacing

//--------------------------------------
// acute accents
//
// shared with Polish kreska, which is steeper than acute
// but such fine distinction is hard in bitmaps anyway.

glyph acute-left 4 2 inline
../1@@0/
/1@@0/..

glyph acute-right 4 2 inline
../0@@1/
/0@@1/..

glyph acute-below mark
ref acute-right
anchor -below 2 0
anchor +below 2 2

glyph acute-below:wide mark
ref acute-left
anchor -below 1..2 0
anchor +below 1..2 2

glyph acute-above mark
ref acute-left
anchor -above 1 1
anchor +above 1 -1

glyph acute-above:wide mark
ref acute-right
anchor -above 1..2 1
anchor +above 1..2 -1

map U+0301 = acute-above
map U+0317 = acute-below

glyph acute-above-spacing
ref sp
ref acute-left 3 0
map ´ = acute-above-spacing

//--------------------------------------
// double acute accents

glyph dacute-above mark
ref acute-right 0 0
ref acute-right 3 0
anchor -above 3 1
anchor +above 3 -1

glyph dacute-above:wide mark
ref acute-left 0 0
ref acute-left 3 0
anchor -above 3..4 1
anchor +above 3..4 -1

map U+030B = dacute-above

//--------------------------------------
// grave accents

glyph grave-right 4 2 inline
\0@@1\..
..\0@@1\

glyph grave-left 4 2 inline
\1@@0\..
..\1@@0\

glyph grave-below mark
ref grave-right
anchor -below 2 0
anchor +below 2 2

glyph grave-below:wide mark
ref grave-left
anchor -below 1..2 0
anchor +below 1..2 2

glyph grave-above mark
ref grave-left
anchor -above 1 1
anchor +above 1 -1

glyph grave-above:wide mark
ref grave-right
anchor -above 1..2 1
anchor +above 1..2 -1

map U+0300 = grave-above
map U+0316 = grave-below

//--------------------------------------
// double grave accents

glyph dgrave-above mark
ref grave-left 0 0
ref grave-left 3 0
anchor -above 3 1
anchor +above 3 -1

glyph dgrave-above:wide mark
ref grave-right 0 0
ref grave-right 3 0
anchor -above 2..3 1
anchor +above 2..3 -1

map U+030F = dgrave-above

//--------------------------------------
// macrons

glyph mac-wide 5 1
@@@@@@@@@@

glyph mac-narrow 4 1
@@@@@@@@

glyph mac-lower 5 1
@@@@@@@@@@

glyph mac-upper 5 1
ref mac-lower 0 0

glyph mac-lower-sm 4 1
@@@@@@@@

glyph mac-upper-sm 4 1
ref mac-lower-sm 0 0

glyph mac-bottom 5 1
ref mac-lower 0 0

glyph mac-bottom-sm 4 1
ref mac-lower-sm 0 0

glyph uni00AF
ref sp
ref mac-lower 2 3
map ¯ = uni00AF

//--------------------------------------
// cedilla/comma

// intended to look like a comma as well
// (the choice between cedilla and comma is ultimately a locale matter
// that is hard to resolve within a single font anyway)
glyph ced 2 3
@@@@
\0@@
@@0/

glyph ced-inverted-lower 2 3
/0@@
@@0\
@@@@

glyph uni00B8
ref sp
ref ced 4 13
map ¸ = uni00B8

//--------------------------------------
// ogonek

glyph ogonek 2 3
/01/
1<..
\1@@

//--------------------------------------
// caron (hacek)

glyph caron-lower 5 2
\01\../10/
..\0@@0/..

glyph caron-upper 5 2
ref caron-lower 0 0

// looks like a comma, used for czech and slovak
glyph caron-alt 2 3
@@@@
\0@@
@@0/

//--------------------------------------
// circumflex

glyph circ 5 2
../0@@0\..
/01/..\10\

glyph circ-lower = circ

glyph circ-upper = circ

glyph circ-bottom = circ

//--------------------------------------
// breve

glyph breve 5 2
@@1\../1@@
\0@@@@@@0/

glyph breve-lower = breve

glyph breve-upper = breve

glyph breve-bottom = breve

//--------------------------------------
// inverted breve (arch)

glyph arch 5 2
/0@@@@@@0\
@@1/..\1@@

glyph arch-lower = arch

glyph arch-upper = arch

//--------------------------------------
// ring

glyph ring 3 3
/0@@0\
@@..@@
\0@@0/

glyph ring-lower = ring

glyph ring-upper = ring

glyph ring-bottom = ring

//--------------------------------------
// tilde

glyph comb-tilde 5 2
/0@@1\../1
1/..\1@@0/

glyph tilde-lower = comb-tilde

glyph tilde-upper = comb-tilde

glyph tilde-bottom = comb-tilde

//--------------------------------------
// dot

glyph comb-dot 2 2
@@@@
@@@@

glyph dot-lower = comb-dot

glyph dot-upper 2 2
ref comb-dot

glyph dot-bottom 2 2
ref comb-dot

glyph dot-middle 2 2
ref comb-dot

//--------------------------------------
// hook above

glyph hook 3 3
/1@@1\
0/..@@
../10/

glyph hook-lower = hook

glyph hook-upper = hook

//--------------------------------------
// tests

// i + combining marks
assert shape ï : uni00EF
assert shape i̤ : i-lower : dia-below offset -4 0
assert shape ï̈ : uni00EF : dia-above offset -4 1
assert shape i̤̤ : i-lower : dia-below offset -4 0 : dia-below offset -4 2
assert shape ï̤ : uni00EF : dia-below offset -4 0
assert shape ï̤ : uni00EF : dia-below offset -4 0

// j + combining marks
assert shape j̈ : j-lower:dotless : dia-above:narrow offset -5 3
assert shape j̤ : j-lower:compressed : dia-below:narrow offset -6 14
assert shape j̈̈ : j-lower:dotless : dia-above:narrow offset -5 3 : dia-above:narrow offset -5 1
assert shape j̤̤ : j-lower:compressed : dia-below:narrow offset -6 14 : dia-below:narrow offset -6 16
// TODO j + U+0308 + U+0324 and j + U+0324 + U+0308 (needs compressed+dotless variant)

