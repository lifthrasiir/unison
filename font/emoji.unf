////////////////////////////////////////
// emoji support

//remap group emojify
//remap group emojify-wide
//remap group emojify-narrow

//remap group deemojify
remap group deemojify-wide
remap group deemojify-narrow

//feature ccmp for DFLT : emojify
//feature wide : ccmp for DFLT : emojify-wide
//feature narrow : ccmp for DFLT : emojify-narrow

//feature ccmp for DFLT : deemojify
feature wide : ccmp for DFLT : deemojify-wide
feature narrow : ccmp for DFLT : deemojify-narrow

glyph vs($1..16) advance 0
ref sp

map U+FE00..FE0F = vs($1..16)

// convenience alias
glyph vs-text = vs15
//glyph vs-emoji = vs16

