map - = hyphen // hyphen-minus
map _ = uline
map ­ = hyphen-short // soft hyphen
map ‐ = hyphen // hyphen
map ‑ = hyphen // non-breaking hyphen
map ‒ = hyphen-short // figure dash
map – = dash // en dash
map wide|narrow : — = dash-double($-half) // em dash
map wide|narrow : ― = hline-double($-half) // horizontal bar
map wide|narrow : ⸺ = dash-quadruple($-half) // 2-em dash
map wide|narrow : ⸻ = dash-sextuple($-half) // 3-em dash
map ‾ = oline
map ⁃ = hyphen-bullet // hyphen bullet
map wide|narrow : ⎯ = hline-double($-half) // horizontal line extension
map ‗ = uuline

map ~ = tilde

