## pre-combined hangul syllable

name-parts $hangul-modern-med-map-for-init = l l l l l l l l t tl tl tl t t tl tl tl t t tl l
name-parts $hangul-modern-med-map-for-fin = l r l r r r r r w w r w w w l r l w w w l

// here we go!
glyph hangul-($#AC00..D7A3)
ref hangul-init-($hangul-modern-init**588)-($hangul-modern-med-map-for-init**28)-(nof|f*27)
ref hangul-med-($hangul-modern-med**28)-(nof|f*27)
ref hangul-fin-($hangul-modern-fin0)-($hangul-modern-med-map-for-fin**28)
map U+AC00..D7A3 = hangul-($#AC00..D7A3)

// there are so many hangul syllables that we want to hide (most of) them from sample.html
exclude-from-sample U+AD00..D699

## combining jamos

// representative glyphs
glyph hangul-init-($hangul-init) = hangul-init-($hangul-init)-l-f
glyph hangul-med-($hangul-med) advance 0
ref hangul-med-($hangul-med)-f -16 0
glyph hangul-fin-($hangul-fin) advance 0
ref hangul-fin-($hangul-fin)-w -16 0

// combining jamo variants
glyph hangul-init- 16 16
glyph hangul-init-comb-($hangul-init)-l-nof
ref hangul-init-($hangul-init)-l-nof
glyph hangul-init-comb-($hangul-init)-l-f
ref hangul-init-($hangul-init)-l-f
glyph hangul-init-comb-($hangul-init)-tl-nof
ref hangul-init-($hangul-init)-tl-nof
glyph hangul-init-comb-($hangul-init)-tl-f
ref hangul-init-($hangul-init)-tl-f
glyph hangul-init-comb-($hangul-init)-t-nof
ref hangul-init-($hangul-init)-t-nof
glyph hangul-init-comb-($hangul-init)-t-f
ref hangul-init-($hangul-init)-t-f
glyph hangul-med- advance 0
ref wsp
glyph hangul-med-comb--(nof|f) advance 0
ref wsp
glyph hangul-med-comb-($hangul-med)-nof advance 0
ref hangul-med-($hangul-med)-nof -16 0
glyph hangul-med-comb-($hangul-med)-f advance 0
ref hangul-med-($hangul-med)-f -16 0
glyph hangul-fin-comb-($hangul-fin)-l advance 0
ref hangul-fin-($hangul-fin)-l -16 0
glyph hangul-fin-comb-($hangul-fin)-w advance 0
ref hangul-fin-($hangul-fin)-w -16 0
glyph hangul-fin-comb-($hangul-fin)-r advance 0
ref hangul-fin-($hangul-fin)-r -16 0

// fillers are spacing but should be different for the purpose of GSUB
map U+115F = hangul-init-
map U+1160 = hangul-med-

map U+1100..1112 = hangul-init-($hangul-modern-init)
map U+1113..115E = hangul-init-($hangul-ancient-init-1)
map U+A960..A97C = hangul-init-($hangul-ancient-init-2)

map U+1161..1175 = hangul-med-($hangul-modern-med)
map U+119E = hangul-med-.
map U+11A1 = hangul-med-.i

map U+11A8..11C2 = hangul-fin-($hangul-modern-fin)
map U+11C3..11FF = hangul-fin-($hangul-ancient-fin-1)
map U+D7CB..D7FB = hangul-fin-($hangul-ancient-fin-2)

// https://www.microsoft.com/typography/OpenTypeDev/hangul/intro.htm

// TODO hangul-ccmp for pre-U5.2 compat

// +--------+  +--------+  +--------+
// |     |  |  |     |  |  |        |
// |     |  |  |     |  |  |        |
// |     |  |  |     |  |  |        |
// |     |  |  |-----+  |  |--------|
// |     |  |  |        |  |        |
// +--------+  +--------+  +--------+
//     l           tl          t
name-parts $hangul-med-for-init-l = a ae ya yae eo e yeo ye i
name-parts $hangul-med-for-init-tl = oa oae oi ueo ue ui eui .i
name-parts $hangul-med-for-init-t = `` o yo u yu eu .

remap hangul-ljmo : hangul-init-($hangul-init) -> hangul-init-comb-($hangul-init)-l-f : hangul-med-($hangul-med-for-init-l) hangul-fin-($hangul-fin)
remap hangul-ljmo : hangul-init-($hangul-init) -> hangul-init-comb-($hangul-init)-tl-f : hangul-med-($hangul-med-for-init-tl) hangul-fin-($hangul-fin)
remap hangul-ljmo : hangul-init-($hangul-init) -> hangul-init-comb-($hangul-init)-t-f : hangul-med-($hangul-med-for-init-t) hangul-fin-($hangul-fin)
remap hangul-ljmo : hangul-init-($hangul-init) -> hangul-init-comb-($hangul-init)-l-nof : hangul-med-($hangul-med-for-init-l)
remap hangul-ljmo : hangul-init-($hangul-init) -> hangul-init-comb-($hangul-init)-tl-nof : hangul-med-($hangul-med-for-init-tl)
remap hangul-ljmo : hangul-init-($hangul-init) -> hangul-init-comb-($hangul-init)-t-nof : hangul-med-($hangul-med-for-init-t)

// The `-t` (top medial) rules above are easy to break by reaching for the
// wrong name-part: the suffix that selects the medial class and the -f/-nof
// suffix that records whether a final follows look alike, and a rule whose
// operands do not expand is dropped by the GSUB builder without a word.
assert shape ᄀᆞ : hangul-init-comb-g-t-nof : hangul-med-comb-.-nof
assert shape ᄀᆞᆨ : hangul-init-comb-g-t-f : hangul-med-comb-.-f : hangul-fin-comb-g-w

remap hangul-vjmo : hangul-med-($hangul-med0) -> hangul-med-comb-($hangul-med0)-f : hangul-fin-($hangul-fin)
remap hangul-vjmo : hangul-med-($hangul-med0) -> hangul-med-comb-($hangul-med0)-nof

name-parts $hangul-med-for-fin-l = a ya ueo ui i
name-parts $hangul-med-for-fin-w = `` o oa oi yo u yu eu eui . .i
name-parts $hangul-med-for-fin-r = ae yae eo e yeo ye oae ue

remap hangul-tjmo : hangul-med-comb-($hangul-med-for-fin-l**2)-f : hangul-fin-($hangul-fin) -> hangul-fin-comb-($hangul-fin)-l
remap hangul-tjmo : hangul-med-comb-($hangul-med-for-fin-w**2)-f : hangul-fin-($hangul-fin) -> hangul-fin-comb-($hangul-fin)-w
remap hangul-tjmo : hangul-med-comb-($hangul-med-for-fin-r**2)-f : hangul-fin-($hangul-fin) -> hangul-fin-comb-($hangul-fin)-r
remap hangul-tjmo : hangul-med-comb-($hangul-med-for-fin-l**2)-nof : hangul-fin-($hangul-fin) -> hangul-fin-comb-($hangul-fin)-l
remap hangul-tjmo : hangul-med-comb-($hangul-med-for-fin-w**2)-nof : hangul-fin-($hangul-fin) -> hangul-fin-comb-($hangul-fin)-w
remap hangul-tjmo : hangul-med-comb-($hangul-med-for-fin-r**2)-nof : hangul-fin-($hangul-fin) -> hangul-fin-comb-($hangul-fin)-r

feature ljmo for hang : hangul-ljmo
feature vjmo for hang : hangul-vjmo
feature tjmo for hang : hangul-tjmo

