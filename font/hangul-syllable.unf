////////////////////////////////////////
// hangul syllables

// the following glyphs are used as representatives for combining jamos:
//   hangul-init-*-l-f, hangul-med-*-f, hangul-fin-*-w
// representative glyphs are converted to appropriate glyphs based on surrounding,
// and assigned a correct advance to get those glyphs overlaid.
// (16px for initials, 0px for medials and finals)
// since their advances should be separately recorded from representatives,
// both sets of glyphs are marked sticky.

name-parts $hangul-modern-init = g gg n d dd r m b bb s ss 0 j jj c k t p h
name-parts $hangul-ancient-init-1 = ng nn nd nb dg rn rr rh l mb w bg bn bd bs bsg bsd bsb bss bsj bj bc bt bp v vv sg sn sd sr sm sb sbg sss s0 sj sc sk st sp sh _s _ss s_ ss_ z 0g 0d 0m 0b 0s 0z 00 0j 0c 0t 0p q j0 _j _jj j_ jj_ ck ch _c c_ pb f hh x gd ns nj nh dr
name-parts $hangul-modern-med = a ae ya yae eo e yeo ye o oa oae oi yo u ueo ue ui yu eu eui i
name-parts $hangul-ancient-med-1 = ao au yao yayo eoo eou eoeu yeoo yeou oeo oe oye oo ou yoya yoyae yoyeo yoo yoi ua uae ueoeu uye uu yua yueo yue yuyeo yuye yuu yui euu eueu euiu ia iya io iu ieu i. . .eo .u .i .. aeu yau yeoya oya oyae
name-parts $hangul-modern-fin = g gg gs n nj nh d r rg rm rb rs rt rp rh m b bs s ss 0 j c k t p h
name-parts $hangul-ancient-fin-1 = gr gsg ng nd ns nz nt dg dr rgs rn rd rdh rr rmg rms rbs rbh rv rss rz rk rq mg mr mb ms mss mz mc mh w br bp bh v sg sd sr sb z qg qgg qq qk q qs qz pb f hn hr hm hb x gn gb gc gk gh nn

name-parts $hangul-ancient-init-2 = dm db ds dj rg rgg rd rdd rm rb rbb rv rs rj rk mg md ms bst bk bh ssb 0r 0h jjh tt ph hs xx

name-parts $hangul-ancient-med-2 = oyeo ooi yoa yoae yoeo uyeo yii yuae yuo eua eueo eue euo iyao iyae iyeo iye ioi iyo iyu ii .a .e
name-parts $hangul-ancient-fin-2 = nr nc dd ddb db ds dsg dj dc dt rgg rgh rrk rrh rbd rbp rq rqh l mn mnn mm mbs mj bd brp bm bb bsd bj bc sm sv ssg ssd sz sj sc st sh zb zv qm qh jb jbb jj ps pt

name-parts $hangul-modern-init0 = `` $hangul-modern-init
name-parts $hangul-modern-med0 = `` $hangul-modern-med
name-parts $hangul-modern-fin0 = `` $hangul-modern-fin

name-parts $hangul-init = $hangul-modern-init $hangul-ancient-init-1 $hangul-ancient-init-2
name-parts $hangul-med = $hangul-modern-med .|.i
name-parts $hangul-fin = $hangul-modern-fin

name-parts $hangul-init0 = `` $hangul-init
name-parts $hangul-med0 = `` $hangul-med
name-parts $hangul-fin0 = `` $hangul-fin

name-parts $hangul-init-lex = g n d r m b s 0 j c k t p h

