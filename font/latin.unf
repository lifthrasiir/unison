## with cedilla

// normalization is no guide to the shape here: apart from S and T, every
// precomposed letter decomposes to U+0327 combining cedilla even where the
// language's convention is a comma below (see the comma section right after
// this one). what is left here is what really wants a cedilla --- French,
// Portuguese and Turkish ç, Turkish/Gagauz ş ţ, and the transliteration
// letters ḑ ȩ ḩ.

map generate Ç
map generate Ḉ
map generate Ḑ
map generate Ȩ
// U+0306 combining breve has no anchored mark glyph, so this one cannot be
// synthesized from its decomposition
glyph e-upper-with-ced-below-breve-upper
ref e-upper
ref ced-below inherit
ref breve-above 2 0 inherit
map Ḝ = e-upper-with-ced-below-breve-upper
map generate Ḩ
map generate Ş = s-upper-with-ced-below
map generate Ţ = t-upper-with-ced-below

map generate ç
map generate ḉ
map generate ḑ
map generate ȩ
glyph e-lower-with-ced-below-breve-upper
ref e-lower
ref ced-below inherit
ref breve-above 2 2 inherit
map ḝ = e-lower-with-ced-below-breve-upper
map generate ḩ
map generate ş = s-lower-with-ced-below
map generate ţ = t-lower-with-ced-below

## with comma below

// Latvian ģ ķ ļ ņ ŗ are encoded as "letter with cedilla" but are drawn with a
// comma; no language uses those five letters with a real cedilla, so the
// choice can be made per glyph and needs no locale. lowercase ģ is the odd
// one out: the descender leaves no room below, so the comma is turned and
// placed above, exactly as U+0312 is.
//
// Romanian ș ț are the one pair unicode did encode separately (U+0218/U+021A,
// added in 3.0 to disambiguate them from Turkish ş ţ), so they decompose to
// U+0326 and need no override.

glyph g-upper-with-com-below
ref g-upper inherit
ref com-below inherit
map Ģ = g-upper-with-com-below
glyph k-upper-with-com-below
ref k-upper inherit
ref com-below inherit
map Ķ = k-upper-with-com-below
glyph l-upper-with-com-below
ref l-upper inherit
ref com-below inherit
map Ļ = l-upper-with-com-below
glyph n-upper-with-com-below
ref n-upper inherit
ref com-below inherit
map Ņ = n-upper-with-com-below
glyph r-upper-with-com-below
ref r-upper inherit
ref com-below inherit
map Ŗ = r-upper-with-com-below
map generate Ș = s-upper-with-com-below
map generate Ț = t-upper-with-com-below

glyph g-lower-with-com-below
ref g-lower inherit
ref com-turned-above inherit
map ģ = g-lower-with-com-below
glyph k-lower-with-com-below
ref k-lower inherit
ref com-below inherit
map ķ = k-lower-with-com-below
glyph l-lower-with-com-below
ref l-lower inherit
ref com-below inherit
map ļ = l-lower-with-com-below
glyph n-lower-with-com-below
ref n-lower inherit
ref com-below inherit
map ņ = n-lower-with-com-below
glyph r-lower-with-com-below
ref r-lower inherit
ref com-below inherit
map ŗ = r-lower-with-com-below
map generate ș = s-lower-with-com-below
map generate ț = t-lower-with-com-below

// Romanian used the Turkish codepoints before U+0218/U+021A existed in unicode
// 3.0, and plenty of text still does, so under a Romanian language system the
// legacy pair is drawn with the comma. this is the one place a locale really
// is needed: the same ş must stay a cedilla for Turkish.
remap romanian-comma : (s|t**2)-(lower|upper)-with-ced-below -> (s|t**2)-(lower|upper)-with-com-below
feature locl for latn/ROM latn/MOL : romanian-comma

// the same five letters have to come out as a comma when the sequence arrives
// decomposed as well. harfbuzz would recompose base + U+0327 into the
// precomposed glyph above, but opentype does not require an engine to
// normalize anything, so the substitution is spelled out.
remap latvian-comma : (g-upper|k-upper|l-upper|n-upper|r-upper|k-lower|l-lower|n-lower|r-lower) : ced-below -> com-below
remap latvian-comma : g-lower : ced-below -> com-turned-above
feature ccmp for DFLT : latvian-comma

// the cedilla and the comma must never collapse into one shape
assert distinct ced-below com-below com-turned-above
assert distinct s-upper-with-ced-below s-upper-with-com-below
assert distinct s-lower-with-ced-below s-lower-with-com-below
assert distinct t-upper-with-ced-below t-upper-with-com-below
assert distinct t-lower-with-ced-below t-lower-with-com-below
assert shape ģ : g-lower-with-com-below
assert shape ķ : k-lower-with-com-below
assert shape Ŗ : r-upper-with-com-below
assert shape ş : s-lower-with-ced-below
assert shape ș : s-lower-with-com-below
// a decomposed sequence is recomposed by the shaper whenever the precomposed
// glyph exists---and for these letters it always does, even with a further
// mark following, so harfbuzz never reaches the `latvian-comma` substitution.
// it is there for the engines that do not normalize at all.
assert shape ķ́ : k-lower-with-com-below : acute-above
assert shape ģ́ : g-lower-with-com-below : acute-above
assert shape ş́ : s-lower-with-ced-below : acute-above

// the Romanian locale, and only it, redraws the legacy Turkish pair.  the
// assertion names a BCP 47 language, not the `latn/ROM` the font declares, so
// it pins that the shaper really does resolve the one to the other
assert shape ş @ro : s-lower-with-com-below
assert shape ţ @ro : t-lower-with-com-below
assert shape ş @mo : s-lower-with-com-below
assert shape ş @tr : s-lower-with-ced-below
assert shape ş @lv : s-lower-with-ced-below
assert shape ş : s-lower-with-ced-below
// Romanian must not lose what the default language system carries: this needs
// `ccmp`, which an explicit language system replaces rather than extends
assert shape j̈ @ro : j-lower:dotless : dia-above:narrow offset -5 3

