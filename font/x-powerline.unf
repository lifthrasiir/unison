# powerline compatibility

prop block `Powerline Compatibility` = U+E0A0..E0BF

// L2/19-068 proposes different but not suitable names
prop U+E0A0 = `BRANCHING LINE WITH NODES` gc So
prop U+E0A1 = `LINE NUMBER SIGN` gc So
prop U+E0A2 = `PADLOCK` gc So
prop U+E0A3 = `COLUMN NUMBER SIGN` gc So
prop U+E0B0 = `RIGHT-POINTING TRIANGULAR BLOCK` gc So
prop U+E0B1 = `BOX DRAWINGS HEAVY DIAGONAL UPPER LEFT TO MIDDLE RIGHT TO LOWER LEFT` gc So // i.e. U+1FBDF but heavier
prop U+E0B2 = `LEFT-POINTING TRIANGULAR BLOCK` gc So
prop U+E0B3 = `BOX DRAWINGS HEAVY DIAGONAL UPPER RIGHT TO MIDDLE LEFT TO LOWER RIGHT` gc So // i.e. U+1FBDD but heavier
prop U+E0B4 = `RIGHT-POINTING CIRCULAR BLOCK` gc So // i.e. U+1FBEB but filling the block
prop U+E0B5 = `BOX DRAWINGS HEAVY ARC UPPER LEFT TO MIDDLE RIGHT TO LOWER LEFT` gc So
prop U+E0B6 = `LEFT-POINTING CIRCULAR BLOCK` gc So // i.e. U+1FBE9 but filling the block
prop U+E0B7 = `BOX DRAWINGS HEAVY ARC UPPER RIGHT TO MIDDLE LEFT TO LOWER RIGHT` gc So

