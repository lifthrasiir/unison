glyph hangul-($hangul-init-lex)-circled
ref enclosing-circle-sbg
ref hangul-($hangul-init-lex)-half 4 0
glyph hangul-($hangul-init-lex)a-circled
ref enclosing-circle-bg
ref hangul-($hangul-init-lex)-half 3 0
ref hangul-a-half-narrow 10 0

