////////////////////////////////////////
// geometric shapes
//
// shapes are always wide because i) their shapes do matter
// and ii) some of them contain emoji which must be wide.
// also, designing squashed shape glyphs is no fun.
//
// size index:
// 1 - tiny
// 2 - very small
// 3 - slightly small
// 4 - small
// 5 - medium small
// 6 - medium
// 7 - (unqualified)
// 8 - large

color emoji-border = #808080
color emoji-white = #FFFFFF
color emoji-black = #000000
color emoji-red = #FF2200
color emoji-green = #55FF00
color emoji-blue = #0000FF
color emoji-yellow = #FFEE00
color emoji-purple = #FF00DD
color emoji-brown = #994422
color emoji-orange = #FF9900

