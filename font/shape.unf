map ∙ = black-circle-2 // bullet operator
map 🞄 = black-circle-3
map • = black-circle-4 // bullet punctuation
map ⦁ = black-circle-5
map ⚫ = black-circle-6
map ● = black-circle-7
map ⬤ = black-circle-8

remap deemojify : black-circle-6 vs-text -> black-circle-6-inside

assert shape ⚫︎ : black-circle-6-inside

