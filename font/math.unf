map + = plus
map wide|narrow : ⧺ = pplus($-half)
map wide|narrow : ⧻ = ppplus($-half)
map − = minus
map ± = plusminus
map ∓ = minusplus
map wide|narrow : × = times($-half)
map wide|narrow : ÷ = div($-half)
map ∔ = dot-over-plus
map ∸ = dot-over-minus
map ⨢ = ring-over-plus
map ⨣ = circ-over-plus
map ⨤ = tilde-over-plus
map ⨥ = plus-over-dot
map ⨦ = plus-over-tilde
map ⨧ = plus-over-sub-2
map ⨨ = plus-with-black-triangle
map ⨩ = com-over-minus
map ⨪ = minus-over-dot
map ⨫ = ldot-over-minus-over-rdot
map ⨬ = rdot-over-minus-over-ldot
map ∕ = div-slash
map √ = 2root
map ∛ = 3root
map ∜ = 4root
map wide|narrow : ⋇ = div-times($-half)
map wide|narrow : ⨭ = plus-in-white-circle-6-l($-half)
map wide|narrow : ⨴ = times-in-white-circle-6-l($-half)
map wide|narrow : ⨮ = plus-in-white-circle-6-r($-half)
map wide|narrow : ⨵ = times-in-white-circle-6-r($-half)

map wide|narrow : ∞ = infty($-half)
map ∆ = delta
map ∇ = nabla

map ∣ = divides
map ∤ = ndivides
map ∶ = ratio
map wide|narrow : ∷ = proportion($-half)

