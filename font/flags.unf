ref 5x-6p1r6 1 8 fill #FFD300
ref 3p3r4x5 1 10 fill #0064AD
ref -7p2r6x-6p1r6 7 8 fill #FFD300
ref -6p1r6x5 8 10 fill #0064AD

// Belgium (aspect 15:13 -> 1:1)
glyph flag-be:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #fdda25
ref 4p2r3x14 1 1 fill #000000
ref -4p2r3x14 10 1 fill #ef3340

// Bulgaria (aspect 5:3 -> 1:1, division 1:1:1)
glyph flag-bg:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #00966E
ref 14x4p2r3 1 1 fill #ffffff
ref 14x-4p2r3 1 10 fill #D62612

// Bahrain (aspect 5:3 -> 1:1, division 5:3:12 -> 2+4/7:3:6+3/7)
glyph flag-bh:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #ffffff
ref flag-bh-right 1 1 fill #DA291C

glyph flag-bh-right 14 14 scale 5
ref -7p1r2x14 30 0
