////////////////////////////////////////
// flags

remap group flag-ri // determine regional indicator left vs. right
remap group flag after flag-ri // pair any known flag sequences
remap group flag-tag-1 after flag // tag sequence fallbacks
remap group flag-tag-2 after flag-tag-1
remap group flag-tag-3 after flag-tag-2
remap group flag-tag-4 after flag-tag-3
remap group flag-tag-5 after flag-tag-4
remap group flag-tag-6 after flag-tag-5

feature ccmp for DFLT : flag
feature ccmp for DFLT : flag-ri
feature ccmp for DFLT : flag-tag-1
feature ccmp for DFLT : flag-tag-2
feature ccmp for DFLT : flag-tag-3
feature ccmp for DFLT : flag-tag-4
feature ccmp for DFLT : flag-tag-5
feature ccmp for DFLT : flag-tag-6

//--------------------------------------
// regional indicator

glyph regional-indicator-single 8 16
