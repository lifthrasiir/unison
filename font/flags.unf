map 🏴 = black-flag

remap flag-tag-1 : black-flag tag-($a-z|$0..9) -> black-flag-hole-1
remap flag-tag-2 : black-flag-hole-1 tag-($a-z|$0..9) -> black-flag-hole-2
remap flag-tag-3 : black-flag-hole-2 tag-($a-z|$0..9) -> black-flag-hole-3
