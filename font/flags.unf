glyph regional-indicator-($a-z) 8 16
ref regional-indicator-single
ref narrow-($a-z)-upper 1 -1

glyph regional-indicator-($a-z)-left 8 16
ref regional-indicator-left
ref narrow-($a-z)-upper 3 -1

glyph regional-indicator-($a-z)-right 8 16
ref regional-indicator-right
ref narrow-($a-z)-upper 0 -1

map U+1F1E6..1F1FF = regional-indicator-($a-z)

remap flag-ri : regional-indicator-($a-z)-left : regional-indicator-($a-z) -> regional-indicator-($a-z)-right
remap flag-ri : regional-indicator-($a-z) -> regional-indicator-($a-z)-left : regional-indicator-($a-z)

