..@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@..
..@@@@..........................................
..@@@@..........................................

map 🏴 = black-flag
map U+E0030..E0039 = tag-($0..9)
map U+E0061..E007A = tag-($a-z)
map U+E007F = tag-cancel

remap flag-tag : black-flag tag-($a-z|$0..9) -> black-flag-($a-z|$0..9)
remap flag-tag : black-flag-($a-z|$0..9) : tag-($a-z|$0..9) -> black-flag-($a-z|$0..9)-cont
remap flag-tag : black-flag-($a-z|$0..9)-cont : tag-($a-z|$0..9) -> black-flag-($a-z|$0..9)-cont
remap flag-tag : black-flag-($a-z|$0..9) : tag-cancel -> black-flag-end
remap flag-tag : black-flag-($a-z|$0..9)-cont : tag-cancel -> black-flag-end

feature ccmp for DFLT : flag-tag

assert shape 🏴󠁡󠁢󠁣󠁿 : black-flag-a : black-flag-b-cont : black-flag-c-cont : black-flag-end

//--------------------------------------
// experimental color flags

// the glyph dimension is limited to 22px by 14px, giving the aspect ratio of 11:7 (~1.57:1).
// any flag larger than 5:3 (~1.67:1) is therefore trimmed or scaled to 11:7 for the uniformity.
// otherwise the flag is scaled to fill either the width and/or height,
// with a minimal adjustment to the aspect ratio to snap to nearest pixel boundaries.

glyph flag-($a-z**26)($a-z):mono
ref regional-indicator-($a-z**26)-left
ref regional-indicator-($a-z)-right 16 0

assume unused flag-($a-z**26)($a-z):mono

