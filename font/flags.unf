remap flag-tag-5 : black-flag-hole-4 tag-($a-z|$0..9) -> black-flag-hole-5

remap flag-tag-6 : black-flag-hole-1 tag-cancel -> black-flag-hole-1-bad
remap flag-tag-6 : black-flag-hole-2 tag-cancel -> black-flag-hole-2-bad
remap flag-tag-6 : black-flag-hole-3 tag-cancel -> black-flag-hole-3-bad
remap flag-tag-6 : black-flag-hole-4 tag-cancel -> black-flag-hole-4-bad
remap flag-tag-6 : black-flag-hole-5 tag-cancel -> black-flag-hole-5-bad

//--------------------------------------
// experimental color flags

glyph flag-($a-z**26)($a-z):mono
ref regional-indicator-($a-z**26)-left
ref regional-indicator-($a-z)-right 8 0

assume unused flag-($a-z**26)($a-z):mono

// Andorra (aspect 10:7 -> 1:1, division 8:9:8 -> 9:10:9)
glyph flag-ad:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #fedd00
ref 4p1r2x14 1 1 fill #10069f
ref -4p1r2x14 10 1 fill #d50032

assume unused flag-ad:color // XX: needs a seal

// United Arab Emirates (aspect 2:1 -> 1:1, division 1:1:1 & 1:3)
glyph flag-ae:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #E1E1E1
ref 14x4p2r3 1 1 fill #00843D
ref 14x-4p2r3 1 10 fill #000000
ref 3p1r2x14 1 1 fill #C8102E

// Antigua and Barbuda (aspect 3:2 -> 1:1, division 9:5:9)
// star outer & inner diameter / height = 15/23 & 15/46
glyph flag-ag:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #000000
ref _9p1r6x-9p1r6-poly16.510 3 1 fill #FCD116
ref 14x-8p3r5 1 6 fill #0072C6
ref 14x-5p1r2 1 9 fill #FFFFFF
ref 7x14-dl 1 1 fill #CC0033
ref 7x14-dr 8 1 fill #CC0033

// Armenia (aspect 2:1 -> 1:1, division 1:1:1)
glyph flag-am:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #0033A0
ref 14x4p2r3 1 1 fill #D90012
ref 14x-4p2r3 1 10 fill #F2A800

// Argentina (aspect 8:5 or 14:9 -> 1:1, division 1:1:1)
glyph flag-ar:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #ffffff
ref 14x4p2r3 1 1 fill #74ACDF
ref 14x-4p2r3 1 10 fill #74ACDF

// Austria (aspect 3:2 -> 1:1, division 1:1:1)
glyph flag-at:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #ffffff
ref 14x4p2r3 1 1 fill #C8102E
ref 14x-4p2r3 1 10 fill #C8102E

// Aruba (aspect 3:2 -> 1:1, division 1:6:5:1:1:1:3)
// star outer & inner diameter / height = 1/3 & 1/9
// star border width / height = 1/133 (inset) -> whatever this is
glyph flag-aw:color 16 16 scale 2
ref 16x16 0 0 fill #00000080
ref 14x14 2 2 fill #418FDE
ref _4p2r3x_4p2r3-poly4.471 3 3 fill #FFFFFF
ref _3p5r6x_3p5r6-poly4.471 4 4 fill #EF3340
ref 14x_2p1r3 2 20 fill #F7D417
ref 14x_0p7r9 2 22 fill #418FDE

// Åland Islands (aspect 26:17 -> 1:1, division 16:3:4:3:26 & 12:3:4:3:12 -> 9+1/7:3:4:3:14+6/7 & 12:3:4:3:12)
glyph flag-ax:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #0064AD
ref -3p1r4x14 4 1 fill #FFD300
ref 0p5r6x14 8 1 fill #FFD300
ref 14x4 1 6 fill #FFD300
ref 1p2r3x14 6 1 fill #DA0E15
ref 14x_1p2r3 1 7 fill #DA0E15

// Azerbaijan (aspect 2:1 -> 1:1, division 1:1:1)
// crescent outer & inner diameter / height = 3/10 & 1/4
// crescent outer & inner center from flag center / height = 1/20 & 1/60
// star outer & inner diameter / height = 1/6 & 1/12
// star center from flag center / height = 7/60
glyph flag-az:color 16 16 scale 4
ref 16x16 0 0 fill #00000080
ref 14x14 4 4 fill #EF3340
ref 14x4p2r3 4 4 fill #00B5E2
ref 14x-4p2r3 4 40 fill #509E2F
ref _4p1r5x_4p1r5-circle 19 22 fill #FFFFFF
ref 3p1r2x_3p1r2-circle 24 24 fill #EF3340
ref 2p1r3x_2p1r3-poly8.459 33 26 fill #FFFFFF

// Bosnia and Herzegovina (aspect 2:1 -> 1:1, division 1:2:1)
// offset from start to next star / height = 1/8 & 1/8
// horizontal offset from star center to antidiagonal / height = 19/100 -> whatever this is
// star-circumscribing circle diameter = 19/100
// bottommost star center from flag bottom = (19sqrt(5)-38)/2 -> 1/112
glyph flag-ba:color 16 16 scale 2
ref 16x16 0 0 fill #00000080
ref 14x14 2 2 fill #001489
ref 7x14-ur 9 2 fill #FFCD00
ref flag-ba-stars 2 2 fill #FFFFFF

glyph flag-ba-stars 10 14 scale 4
ref _2p2r3x_2p2r3-poly5r2 -1 -7
ref _2p2r3x_2p2r3-poly5r2 3 1
ref _2p2r3x_2p2r3-poly5r2 7 9
ref _2p2r3x_2p2r3-poly5r2 11 17
ref _2p2r3x_2p2r3-poly5r2 15 25
ref _2p2r3x_2p2r3-poly5r2 19 33
ref _2p2r3x_2p2r3-poly5r2 23 41
ref _2p2r3x_2p2r3-poly5r2 27 49
ref 11x2 -4 -8 negated
ref 11x1 -4 56 negated

// Bangladesh (aspect 5:3 -> 1:1)
// circle diameter / height = 2/3
// circle center from flag center / height = 1/12 -> 1/28
glyph flag-bd:color 16 16 scale 2
ref 16x16 0 0 fill #00000080
ref 14x14 2 2 fill #006747
ref _9p1r3x_9p1r3-circle 5 6 fill #DA291C

// Belgium (aspect 15:13 -> 1:1)
glyph flag-be:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #fdda25
ref 4p2r3x14 1 1 fill #000000
ref -4p2r3x14 10 1 fill #ef3340

// Burkina Faso (aspect 3:2 -> 1:1, division 1:1)
// star-circumscribing circle diameter / height = 1/3
glyph flag-bf:color 16 16 scale 2
ref 16x16 0 0 fill #00000080
ref 14x7 2 2 fill #EF2B2D
ref 14x7 2 16 fill #009E49
ref _4p2r3x_4p2r3-poly5r2 11 11 fill #FCD116

// Bulgaria (aspect 5:3 -> 1:1, division 1:1:1)
glyph flag-bg:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #00966E
ref 14x4p2r3 1 1 fill #ffffff
ref 14x-4p2r3 1 10 fill #D62612

// Bahrain (aspect 5:3 -> 1:1, division 5:3:12 -> 2+4/7:3:6+3/7)
glyph flag-bh:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #ffffff
ref flag-bh-right 1 1 fill #DA291C

glyph flag-bh-right 14 14 scale 5
ref -7p1r2x14 30 0
ref 3p5r10x1p4r10-ur 15 0
ref 3p5r10x-1p4r10-dr 15 4
ref 3p5r10x1p4r10-ur 15 14
ref 3p5r10x-1p4r10-dr 15 18
ref 3p5r10x1p4r10-ur 15 28
ref 3p5r10x-1p4r10-dr 15 32
ref 3p5r10x1p4r10-ur 15 42
ref 3p5r10x-1p4r10-dr 15 46
ref 3p5r10x1p4r10-ur 15 56
ref 3p5r10x-1p4r10-dr 15 60

// Benin (aspect 3:2 -> 1:1, division 2:3 & 1:1)
glyph flag-bj:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x7 1 1 fill #FCD20F
ref 14x7 1 8 fill #E90929
ref 5p3r5x14 1 1 fill #008850

// Bolivia (aspect 22:15 -> 1:1, division 1:1:1)
glyph flag-bo:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x14 1 1 fill #F4E400
ref 14x4p2r3 1 1 fill #DA291C
ref 14x-4p2r3 1 10 fill #007A33

// Brazil (aspect 10:7 -> 1:1, division 17:48:70:48:17 & 17:18:70:18:17)
glyph flag-br:color 16 16 scale 2
ref 16x16 0 0 fill #00000080
ref 14x14 2 2 fill #302681
ref flag-br-arc 0 13 fill #ffffff
ref flag-br-stars 10 13 fill #ffffff
ref flag-br-slogan 8 13 fill #009440
ref flag-br-hole 2 2 fill #ffcb00
ref 9p4r5x8-ul 2 2 fill #009440
ref -9p4r5x8-ur 10 2 fill #009440
ref 9p4r5x8-dl 2 14 fill #009440
ref -9p4r5x8-dr 10 14 fill #009440

glyph flag-br-slogan 7 2 scale 32
