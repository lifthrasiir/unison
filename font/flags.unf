glyph regional-indicator-($a-z) 16 16
ref regional-indicator-single
ref ($a-z)-upper 4 -1

glyph regional-indicator-($a-z)-left 16 16
ref regional-indicator-left
ref ($a-z)-upper 4 -1

glyph regional-indicator-($a-z)-right 8 16 advance 8
ref regional-indicator-right
ref ($a-z)-upper -4 -1

map U+1F1E6..1F1FF = regional-indicator-($a-z)

remap regional-indicator : regional-indicator-($a-z)-left : regional-indicator-($a-z) -> regional-indicator-($a-z)-right
remap regional-indicator : regional-indicator-($a-z) -> regional-indicator-($a-z)-left : regional-indicator-($a-z)

feature liga for DFLT : regional-indicator

//--------------------------------------
// experimental color flags

// the glyph dimension is limited to 22px by 14px, giving the aspect ratio of 11:7 (~1.57:1).
// any flag larger than 5:3 (~1.67:1) is therefore trimmed or scaled to 11:7 for the uniformity.
// otherwise the flag is scaled to fill either the width and/or height,
// with a minimal adjustment to the aspect ratio to snap to nearest pixel boundaries.

glyph flag-($a-z**26)($a-z):mono
ref regional-indicator-($a-z**26)-left
ref regional-indicator-($a-z)-right 16 0

assume unused flag-($a-z**26)($a-z):mono

