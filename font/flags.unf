ref 3p5r10x-1p4r10-dr 15 60

// Benin (aspect 3:2 -> 1:1, division 2:3 & 1:1)
glyph flag-bj:color 16 16
ref 16x16 0 0 fill #00000080
ref 14x7 1 1 fill #FCD20F
ref 14x7 1 8 fill #E90929
ref 5p3r5x14 1 1 fill #008850

