@@@@@@@@@@@@@@@@
@@@@@@@@@@@@@@@@
@@@@@@@@@@@@@@@@
................
................

glyph black-flag-($a-z)-cont 8 16 left -3
ref black-flag-cont -3 0
ref ($a-z)-upper -3 -1 negated

glyph black-flag-($0..9)-cont 8 16 left -3
ref black-flag-cont -3 0
ref ($0..9) -3 -1 negated

glyph black-flag-end-aux 2 16
@@@@
@@@@
@@@@
@@@@
@@@@
@@@@
@@@@
@@@@
@@@@
@@@@
@@@@
@@@@
@@@@
@@@@
