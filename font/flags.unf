ref 18x16 3 0 fill #00000080
ref 16x14 4 1 fill #fdda25
ref 5p1r3x14 4 1 fill #000000
ref -5p1r3x14 14 1 fill #ef3340

// Bahrain (aspect 5:3 -> 22:13)
